# Nimbus – production environment variables
# Copy this file to .env and fill in every value before running docker compose.
# Never commit the real .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
# Password for the nimbus PostgreSQL user.
# DATABASE_URL is assembled automatically in docker-compose.yml using this.
DB_PASSWORD=change_me_strong_password

# ── License signing keys ──────────────────────────────────────────────────────
# Generate a fresh keypair:  cd apps/backend && go run ./scripts/gen_keys
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# ── Admin API ─────────────────────────────────────────────────────────────────
# Protects the /admin/v1/* routes on the Go backend.
# Generate: openssl rand -hex 32
ADMIN_API_SECRET=

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Live keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_live_
RAZORPAY_KEY_SECRET=

# Webhook secret — Razorpay Dashboard → Webhooks → your endpoint → Secret
RAZORPAY_WEBHOOK_SECRET=

# ── Razorpay annual plan IDs ─────────────────────────────────────────────────
# Create in Razorpay Dashboard → Subscriptions → Plans.
# All Nimbus plans are billed annually — no monthly plans.
RAZORPAY_PLAN_PERSONAL_ANNUAL=plan_
RAZORPAY_PLAN_PRO_ANNUAL=plan_
RAZORPAY_PLAN_AGENCY_ANNUAL=plan_

# ── Backend tuning ────────────────────────────────────────────────────────────
# How many days a signed token is valid before the plugin must re-activate.
TOKEN_TTL_DAYS=30

# Product slug that must exist in the database.
PRODUCT_SLUG=nimbus
