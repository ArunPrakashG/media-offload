meta {
  name: Rewrite Integration URLs
  type: http
  seq: 1
}

post {
  url: {{wpBaseUrl}}/wp-json/nimbus/v1/integrations/elementor/rewrite
  body: none
  auth: none
}

headers {
  X-WP-Nonce: {{wpNonce}}
}

docs {
  Rewrites asset URLs stored by a supported integration so they point to your
  cloud storage instead of the local server.

  Replace "elementor" in the URL with the integration key returned by GET /integrations.
  Common keys depend on which plugins are active (e.g. elementor, woocommerce, etc.).

  Returns {integration, result} on success.
  Returns 400 if the integration does not support rewrite automation or credentials are missing.
}
