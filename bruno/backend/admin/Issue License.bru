meta {
  name: Issue License
  type: http
  seq: 1
}

post {
  url: {{backendUrl}}/admin/v1/licenses/issue
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "customer@example.com",
    "tier": "personal",
    "payment_id": "pay_XXXXXXXXXXXX",
    "order_id": "order_XXXXXXXXXXXX",
    "subscription_id": "sub_XXXXXXXXXXXX",
    "billing_cycle": "monthly"
  }
}

docs {
  tier: "personal" | "pro" | "agency"
  billing_cycle: "monthly" | "annual" (default: "monthly")
  subscription_id and payment_id are optional but recommended for audit trail.
}
