meta {
  name: Check Update
  type: http
  seq: 1
}

get {
  url: {{backendUrl}}/v1/updates/check?version=1.0.0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{activationToken}}
}

params:query {
  version: 1.0.0
}

docs {
  version: the currently installed plugin version (e.g. "1.0.0")
  Returns update_available=true and download metadata when a newer release exists
  and the license is active. Returns reason="license_inactive" if the license has expired.
}
