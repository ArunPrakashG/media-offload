meta {
  name: Verify Payment
  type: http
  seq: 2
}

post {
  url: {{backendUrl}}/v1/checkout/verify-payment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "subscriptionId": "sub_XXXXXXXXXXXX",
    "paymentId": "pay_XXXXXXXXXXXX",
    "signature": "razorpay-hmac-sha256-signature",
    "plan": "personal",
    "billingCycle": "annual",
    "email": "customer@example.com"
  }
}

docs {
  Verifies the Razorpay payment signature and issues a license immediately.
  signature = HMAC-SHA256(paymentId + "|" + subscriptionId, razorpay_key_secret)
  Returns the license key on success.
}
