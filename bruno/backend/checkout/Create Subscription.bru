meta {
  name: Create Subscription
  type: http
  seq: 1
}

post {
  url: {{backendUrl}}/v1/checkout/create-subscription
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "plan": "personal",
    "email": "customer@example.com"
  }
}

docs {
  plan: "personal" | "pro" | "agency"
  Returns subscriptionId and keyId needed to open the Razorpay checkout widget.
  The backend creates an annual subscription via Razorpay API.
}
