# ── Server ────────────────────────────────────────────────────────────────────
PORT=8090

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://nimbus:nimbus@localhost:5433/nimbus_backend

# ── Redis (rate limiting) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── License signing keys ──────────────────────────────────────────────────────
# Generate with: go run ./scripts/gen_keys
LICENSE_PRIVATE_KEY=<base64-encoded-ed25519-private-key-64-bytes>
LICENSE_PUBLIC_KEY=<base64-encoded-ed25519-public-key-32-bytes>

# ── Optional ──────────────────────────────────────────────────────────────────
# How many days a signed token is valid before the plugin must re-activate.
# Default: 30
TOKEN_TTL_DAYS=30

# ── Admin API ─────────────────────────────────────────────────────────────────
# Secret for the /admin/v1/* routes used by the Astro web app to issue licenses
# after a successful Razorpay payment. Keep this out of source control.
# Generate a strong random value: openssl rand -hex 32
ADMIN_API_SECRET=

# Product slug in the database to assign new licenses to.
# Default: nimbus
PRODUCT_SLUG=nimbus

# ── Razorpay ────────────────────────────────────────────────────────────────
# Test keys start with rzp_test_; live keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
# Used to verify the X-Razorpay-Signature header on incoming webhook calls.
RAZORPAY_WEBHOOK_SECRET=

# ── Razorpay Plan IDs ────────────────────────────────────────────────────────
# Create plans in Razorpay Dashboard → Subscriptions → Plans (or via API).
# One plan per tier × billing cycle combination.
RAZORPAY_PLAN_PERSONAL_MONTHLY=plan_
RAZORPAY_PLAN_PRO_MONTHLY=plan_
RAZORPAY_PLAN_AGENCY_MONTHLY=plan_
RAZORPAY_PLAN_PERSONAL_ANNUAL=plan_
RAZORPAY_PLAN_PRO_ANNUAL=plan_
RAZORPAY_PLAN_AGENCY_ANNUAL=plan_
