---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Mark from '../components/Mark.astro';
import Base from '../layouts/Base.astro';
import { FAQ, PROVIDERS, SITE } from '../lib/site';

const check = '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const ring = '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.8"/></svg>';
const arrow = '<svg width="28" height="10" viewBox="0 0 28 10" fill="none" aria-hidden="true"><path d="M0 5h26M22 1l4 4-4 4" stroke="#5A616C" stroke-width="1.4"/></svg>';

const features = [
  { title: 'Bulk migration', body: 'Move thousands of existing files in the background. Pause, resume and retry failures.', icon: '<path d="M4 7h16M4 12h10M4 17h7"/><path d="M17 15l3 3-3 3"/>' },
  { title: 'Restore any time', body: 'Pull files back to your server and revert URLs, one attachment or the whole library.', icon: '<path d="M4 12a8 8 0 1 0 2.3-5.6"/><path d="M4 4v4h4"/>' },
  { title: 'Cache purge', body: 'Cloudflare, LiteSpeed, WP Fastest Cache and proxy caches are cleared after each change.', icon: '<path d="M3 12h4l3-8 4 16 3-8h4"/>' },
  { title: 'Page builders', body: 'URLs stored by Elementor, Slider Revolution, Smart Slider 3 and NextGEN Gallery are rewritten too.', icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/>' },
  { title: 'WooCommerce downloads', body: 'Protected product files are delivered through short-lived signed storage URLs.', icon: '<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>' },
  { title: 'Multisite', body: 'A network admin panel with offload totals for every site.', icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.description,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.description,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'WordPress plugin',
    operatingSystem: 'WordPress 6.0 or later, PHP 8.1 or later',
    softwareVersion: SITE.version,
    license: 'https://opensource.org/license/mit',
    isAccessibleForFree: true,
    codeRepository: SITE.repo,
    downloadUrl: SITE.releases,
    image: `${SITE.url}/og.png`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={SITE.name} description={SITE.description} markdown="/index.md" jsonLd={jsonLd}>
  <Header />
  <main id="main">
    <section class="wrap hero-section">
      <div class="hero">
        <div class="hero-copy">
          <p class="pill"><span class="pill-tag">MIT</span>Free and open source WordPress plugin</p>
          <h1 class="h1">Move your media to the cloud. Keep your workflow.</h1>
          <p class="lead">Plume offloads your Media Library to Amazon S3, Cloudflare R2 or any S3-compatible bucket, and rewrites every URL so pages load from storage or your CDN.</p>
          <div class="actions">
            <a href="/docs/" class="btn btn-primary btn-lg">Get Plume<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <a href="/docs/setup-wizard/" class="btn btn-secondary btn-lg">Read the docs</a>
          </div>
          <p class="requirements">WordPress 6.0+ · PHP 8.1+ · Multisite ready</p>
        </div>

        <figure class="rewrite" aria-labelledby="rewrite-caption">
          <figcaption id="rewrite-caption" class="sr-only">After offloading, a media URL moves from example.com/wp-content/uploads to media.example.com.</figcaption>
          <div class="rewrite-bar" aria-hidden="true"><span>hero.webp · attachment 1284</span><span class="rewrite-state"><Fragment set:html={check} />Offloaded</span></div>
          <div class="rewrite-body" aria-hidden="true">
            <div class="rewrite-row"><span class="rewrite-label">before</span><code class="rewrite-before">https://<span class="rewrite-old">example.com/wp-content/uploads</span>/2026/11/hero.webp</code></div>
            <div class="rewrite-row rewrite-after"><span class="rewrite-label">after</span><code>https://<span class="rewrite-new">media.example.com</span>/2026/11/hero.webp</code></div>
          </div>
          <div class="rewrite-flow" aria-hidden="true">
            <div class="flow-node"><span class="logo-tile"><img src="/logos/wordpress.svg" alt="" width="26" height="26" /></span>Media Library</div>
            <Fragment set:html={arrow} />
            <div class="flow-node"><Mark size={40} />Plume</div>
            <Fragment set:html={arrow} />
            <div class="flow-node"><span class="logo-tile"><img src="/logos/cloudflare.svg" alt="" width="26" height="26" /></span>R2 bucket</div>
          </div>
        </figure>
      </div>
    </section>

    <section class="band" aria-labelledby="providers-h">
      <div class="wrap providers">
        <h2 id="providers-h" class="eyebrow">Works with the storage you already use</h2>
        <ul class="grid4">
          {PROVIDERS.map((p) => (
            <li><a class="provider" href={`/docs/providers/${p.slug}/`}><span class="provider-logo"><img src={`/logos/${p.logo}.svg`} alt="" width="22" height="22" /></span>{p.name}</a></li>
          ))}
          <li><a class="provider provider-any" href="/docs/providers/s3-compatible/"><span class="provider-logo is-text">S3</span>Any S3-compatible API</a></li>
        </ul>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="how-h">
      <h2 id="how-h" class="h2 section-title">Set it up once. Plume handles every upload after that.</h2>
      <ol class="grid3">
        <li class="step"><span class="step-num">01</span><h3>Connect a bucket</h3><p>Pick a provider, paste your keys and test the connection from the setup wizard.</p></li>
        <li class="step"><span class="step-num">02</span><h3>Offload your library</h3><p>New uploads go to storage automatically. Existing files move in a bulk job you can pause and resume.</p></li>
        <li class="step"><span class="step-num">03</span><h3>Serve from the edge</h3><p>URLs in posts and metadata point to your bucket or CDN domain, and caches are purged for you.</p></li>
      </ol>
    </section>

    <section class="shot-band" aria-label="Plume dashboard in WordPress">
      <div class="wrap">
        <figure class="shot">
          <div class="shot-frame" aria-hidden="true">
            <div class="shot-side">
              <span>Dashboard</span><span>Posts</span><span class="is-current">Media</span><span class="is-sub">Library</span><span class="is-sub is-active">Plume</span><span>Pages</span><span>Plugins</span>
            </div>
            <div class="shot-main">
              <div class="shot-head">
                <div class="shot-title"><Mark framed={false} />Plume</div>
                <span class="shot-conn"><img src="/logos/cloudflare.svg" alt="" width="18" height="18" />Connected · nimbus-media</span>
              </div>
              <div class="shot-stats">
                <div class="shot-card"><span>Offloaded</span><strong>1,247</strong></div>
                <div class="shot-card"><span>Local only</span><strong>55</strong></div>
                <div class="shot-card"><span>In storage</span><strong>4.2 GB</strong></div>
                <div class="shot-card"><span>Failed</span><strong>0</strong></div>
              </div>
              <div class="shot-progress">
                <div class="shot-progress-head"><span>Library in storage</span><span>96%</span></div>
                <div class="bar"><div class="bar-fill"></div></div>
              </div>
              <ul class="shot-files">
                <li><span class="shot-file">2026/11/hero.webp</span><span class="shot-size">412 KB</span><span class="status status-ok"><Fragment set:html={check} />Offloaded</span></li>
                <li><span class="shot-file">2026/11/team-offsite.jpg</span><span class="shot-size">1.8 MB</span><span class="status status-ok"><Fragment set:html={check} />Offloaded</span></li>
                <li><span class="shot-file">2026/10/price-list.pdf</span><span class="shot-size">96 KB</span><span class="status status-local"><Fragment set:html={ring} />Local only</span></li>
              </ul>
            </div>
          </div>
          <figcaption class="sr-only">The Plume overview inside WordPress admin, showing connection status and offload totals.</figcaption>
        </figure>
      </div>
    </section>

    <section id="features" class="wrap section" aria-labelledby="feat-h">
      <h2 id="feat-h" class="h2 section-title">Everything the job needs. Nothing behind a license key.</h2>
      <ul class="grid3">
        {features.map((f) => (
          <li class="feature">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="cli" aria-labelledby="cli-h">
      <div class="wrap split">
        <div class="split-copy">
          <h2 id="cli-h" class="h2">Script it with WP-CLI.</h2>
          <p class="body-lg">Offload, rewrite, revert and download from the terminal. Handy for staging pushes and large libraries.</p>
          <a href="/docs/reference/wp-cli/" class="text-link">All commands</a>
        </div>
        <pre class="terminal" aria-label="Example WP-CLI session"><code><span class="t-dim">$</span> wp nimbus sync --limit=500
<span class="t-ok">Success:</span> Queued 482 attachment(s) for sync.
<span class="t-dim">$</span> wp nimbus rewrite
<span class="t-ok">Success:</span> Rewrote media URLs in 418 post(s).
<span class="t-dim">$</span> wp nimbus download --ids=1284
<span class="t-ok">Success:</span> Download complete. Success: 1, Failed: 0</code></pre>
      </div>
    </section>

    <section class="oss" aria-labelledby="oss-h">
      <div class="wrap split">
        <div class="split-copy">
          <h2 id="oss-h" class="h2">Free, and open source for good.</h2>
          <p class="body-lg">MIT licensed. No license server, no telemetry, no paid tier. Read the code, file an issue or send a pull request.</p>
          <div class="actions">
            <a href={SITE.repo} class="btn btn-primary btn-lg">Star on GitHub</a>
            <a href={SITE.contributing} class="btn btn-secondary btn-lg">Contributing guide</a>
          </div>
        </div>
        <dl class="facts">
          <div><dt>Price</dt><dd>$0</dd></div>
          <div><dt>License</dt><dd>MIT</dd></div>
          <div><dt>Calls home</dt><dd>Never</dd></div>
          <div><dt>Features locked</dt><dd>None</dd></div>
        </dl>
      </div>
    </section>

    <section class="wrap faq" aria-labelledby="faq-h">
      <div class="split">
        <h2 id="faq-h" class="h2">Questions</h2>
        <div class="faq-list">
          {FAQ.map((f, i) => (
            <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
