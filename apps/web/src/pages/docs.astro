        <!-- REST API -->
        <section id="rest-api" class="docs-section">
          <h2>REST API</h2>
          <p>
            All endpoints are under <code>/wp-json/nimbus/v1/</code> and require a
            WordPress administrator session (<code>manage_options</code>
            capability).
          </p>
          <div class="docs-table-wrap">
