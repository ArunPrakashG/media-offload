---
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import Base from "@layouts/Base.astro";
---

<Base
  title="Documentation — Nimbus"
  description="Learn how to install Nimbus, connect your storage bucket, offload your media library, and get the most out of every feature."
>
  <Navbar />
  <main id="main-content" class="docs-page">
    <div class="container docs-container">
      <!-- Sidebar -->
      <aside class="docs-sidebar" aria-label="Documentation navigation">
        <a class="back-link" href="/">
          <svg
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M10 3L5 8l5 5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Back to Nimbus
        </a>
        <nav class="docs-nav">
          <p class="docs-nav-label">On this page</p>
          <ul>
            <li><a href="#installation">Installation</a></li>
            <li><a href="#onboarding">Onboarding</a></li>
            <li><a href="#providers">Connect your bucket</a></li>
            <li><a href="#offloading">Offloading media</a></li>
            <li><a href="#bulk-migration">Bulk migration</a></li>
            <li><a href="#switching-providers">Switching providers</a></li>
            <li><a href="#restore">Restoring files</a></li>
            <li><a href="#settings">Key settings</a></li>
            <li><a href="#nightly">Nightly scheduling</a></li>
            <li><a href="#cache-purge">Cache purge</a></li>
            <li><a href="#integrations">Plugin integrations</a></li>
            <li><a href="#woocommerce">WooCommerce</a></li>
            <li><a href="#multisite">Multisite</a></li>
            <li><a href="#config-backup">Config export & import</a></li>
            <li><a href="#cli">WP-CLI</a></li>
            <li><a href="#rest-api">REST API</a></li>
            <li><a href="#troubleshooting">Troubleshooting</a></li>
          </ul>
        </nav>
      </aside>

      <!-- Content -->
      <article class="docs-content">
        <header class="docs-header">
          <p class="section-label">Nimbus</p>
          <h1 class="docs-title">Documentation</h1>
          <p class="docs-intro">
            Everything you need to install Nimbus, connect your storage bucket,
            offload your media library, and keep things running smoothly —
            written for site owners, not developers.
          </p>
        </header>

        <!-- Installation -->
        <section id="installation" class="docs-section">
          <h2>Installation</h2>
          <p>
            Nimbus is a standard WordPress plugin. You do not need Composer,
            WP-CLI, or any server access to install it.
          </p>
          <ol>
            <li>
              Get Nimbus from the <strong>WordPress plugin directory</strong>,
              or download it from <strong>GitHub</strong>.
            </li>
            <li>
              In your WordPress admin, go to <strong
                >Plugins → Add New</strong
              >, search for "Nimbus", click <strong>Install Now</strong>, then <strong
                >Activate</strong
              > (or upload the ZIP via <strong>Plugins → Add New → Upload Plugin</strong>
              if you downloaded it from GitHub).
            </li>
            <li>
              After activation you will be automatically redirected to the
              <strong>Nimbus → Onboarding</strong> screen.
            </li>
          </ol>
          <p>
            <strong>System requirements:</strong> WordPress 6.0+, PHP 8.1+. That's
            it — no other dependencies, no license key.
          </p>
        </section>

        <!-- Onboarding -->
        <section id="onboarding" class="docs-section">
          <h2>Onboarding</h2>
          <p>
            The first time you open Nimbus after activation, the Onboarding
            screen walks you straight through connecting your storage:
          </p>
          <ol>
            <li>
              <strong>Connect your storage bucket.</strong> Choose a provider, fill
              in your credentials, and click <em>Test Connection</em>. Nimbus
              does a real write check and tells you exactly what's wrong if
              anything fails.
            </li>
          </ol>
          <p>
            That's it — every Nimbus feature is unlocked immediately, with no
            license key or sign-up step.
          </p>
        </section>

        <!-- Connect your bucket -->
        <section id="providers" class="docs-section">
          <h2>Connect your bucket</h2>
          <p>
            Nimbus ships with nine dedicated provider profiles. Each one
            pre-fills the correct endpoint, region, and path-style settings for
            you — just enter your credentials.
          </p>

          <div class="docs-cards">
            <div class="docs-card">
              <h3>Amazon S3</h3>
              <p>
                Standard AWS S3 bucket. Supports all regions and custom
                CloudFront domain aliases.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>Access Key ID, Secret Access Key, Bucket name, Region</dd>
                <dt>Optional</dt>
                <dd>Custom domain / CloudFront URL, bucket path prefix</dd>
              </dl>
            </div>

            <div class="docs-card">
              <h3>Cloudflare R2</h3>
              <p>
                Zero egress fee storage. Enter your Account ID — endpoint,
                region, and path-style are all set automatically.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>
                  R2 Access Key ID, Secret Access Key, Bucket name, Account ID
                </dd>
                <dt>Optional</dt>
                <dd>
                  Custom <code>r2.dev</code> public URL or a Workers-fronted domain
                </dd>
              </dl>
            </div>

            <div class="docs-card">
              <h3>Google Cloud Storage</h3>
              <p>
                GCS via the S3-compatible XML API. Uses HMAC keys — not a
                service account JSON file.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>HMAC Access Key, HMAC Secret, Bucket name</dd>
                <dt>Notes</dt>
                <dd>
                  Generate HMAC keys in GCS console under IAM → Service
                  Accounts. Uniform bucket-level access must be enabled.
                </dd>
              </dl>
            </div>

            <div class="docs-card">
              <h3>DigitalOcean Spaces</h3>
              <p>
                Spaces Object Storage with optional built-in CDN. Uses
                virtual-hosted style — no path-style required.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>Access Key, Secret Key, Bucket (Space) name, Region</dd>
                <dt>Optional</dt>
                <dd>
                  Spaces CDN URL (enable CDN in the DO control panel first)
                </dd>
              </dl>
            </div>

            <div class="docs-card">
              <h3>Backblaze B2</h3>
              <p>
                B2 Cloud Storage via the S3-compatible API. Uses Application
                Keys, not your master account key.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>
                  Application Key ID, Application Key, Bucket name, Region (e.g. <code
                    >us-west-004</code
                  >)
                </dd>
              </dl>
            </div>

            <div class="docs-card">
              <h3>Wasabi</h3>
              <p>
                Hot cloud storage with no egress or API call fees. Endpoint is
                auto-filled from your chosen region.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>Access Key, Secret Key, Bucket name, Region</dd>
              </dl>
            </div>

            <div class="docs-card">
              <h3>MinIO</h3>
              <p>
                Self-hosted S3-compatible server. Path-style endpoint is enabled
                automatically.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>Endpoint URL, Access Key, Secret Key, Bucket name</dd>
              </dl>
            </div>

            <div class="docs-card">
              <h3>S3-compatible (generic)</h3>
              <p>
                Any provider with an S3-compatible API not listed above: Vultr
                Object Storage, Linode Object Storage, Tigris, and others.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>
                  Custom endpoint URL, Access Key, Secret Key, Bucket name,
                  Region
                </dd>
              </dl>
            </div>
          </div>

          <h3>Create a bucket from WordPress</h3>
          <p>
            On most providers you can create a new bucket directly from the
            Nimbus settings screen — no need to open a separate browser tab or
            console. Click <strong>Create bucket</strong> next to the bucket name
            field after entering your credentials.
          </p>
        </section>

        <!-- Offloading media -->
        <section id="offloading" class="docs-section">
          <h2>Offloading media</h2>

          <h3>New uploads go automatically</h3>
          <p>
            Once Nimbus is connected and <strong>Offload New Uploads</strong> is on
            (the default), every image or file you upload through the WordPress media
            library or any editor is sent to your cloud bucket immediately — the upload
            finishes and the file is already in the cloud.
          </p>

          <h3>What gets stored in your database</h3>
          <p>
            After a successful offload, Nimbus writes four things to your
            database:
          </p>
          <ul>
            <li>
              The <strong>storage key</strong> (e.g. <code
                >2024/01/photo.jpg</code
              >) is saved in the <code>_nimbus</code> postmeta field, along with keys
              for every image size variant.
            </li>
            <li>
              <code>_wp_attached_file</code> is updated to the relative storage key.
            </li>
            <li>
              <code>_wp_attachment_metadata['file']</code> is updated to the same
              relative storage key.
            </li>
            <li>
              Any occurrence of the local upload URL in <code>post_content</code
              > is replaced with the CDN URL.
            </li>
          </ul>
          <p>
            Importantly, Nimbus stores a <em>relative path</em>, not a full
            provider URL. This means switching CDN domains or even changing your
            storage provider requires only a settings change — no database
            find-replace operation. All four writes are fully reversed when you
            restore a file.
          </p>

          <h3>Serve from storage</h3>
          <p>
            Toggle <strong>Serve From Storage</strong> to flip all attachment URLs
            from local (<code>yoursite.com/wp-content/uploads/…</code>) to your
            CDN or bucket URL. Flip it off to instantly serve everything from
            disk again — no data changes, just a settings toggle.
          </p>

          <h3>Remove local copies</h3>
          <p>
            Enable <strong>Remove Local Copies</strong> to delete the file from your
            server after a successful offload, freeing up disk space. We recommend
            leaving this off until you have confirmed that offloads and URL rewrites
            are working correctly for your site.
          </p>

          <h3>Media library status column</h3>
          <p>
            The WordPress Media Library shows a <strong>Nimbus</strong> column with
            a status badge for every attachment: <em>Offloaded</em>,
            <em>Pending</em>, <em>Failed</em>, <em>Ignored</em>, or
            <em>Local</em>. You can filter by status using the dropdown at the
            top of the Media Library, and use row actions to offload, retry, or
            restore individual files.
          </p>
        </section>

        <!-- Bulk migration -->
        <section id="bulk-migration" class="docs-section">
          <h2>Bulk migration</h2>
          <p>
            If you have an existing media library that hasn't been offloaded
            yet, the <strong>bulk migration job</strong> handles it in the background
            — no WP-CLI, no timeouts, no manual batching.
          </p>

          <h3>Starting a job</h3>
          <p>
            Go to <strong>Nimbus → Jobs</strong> and click <strong
              >Start bulk offload</strong
            >. The job processes your library in batches (up to 100 files per
            tick) on a 2-second cron interval. You can see live progress —
            files processed, succeeded, failed, and skipped — in real time as
            the job runs.
          </p>

          <h3>Pause and resume</h3>
          <p>
            Click <strong>Pause</strong> at any time to stop the job cleanly. Nimbus
            saves its exact position. Click <strong>Resume</strong> later and it picks
            up from the same file, without re-processing anything that already succeeded.
          </p>

          <h3>Retry failed files</h3>
          <p>
            When a job finishes, any files that failed are recorded. Use
            <strong>Retry failed</strong> to re-run only the failures without touching
            files that already succeeded.
          </p>

          <h3>Restore local</h3>
          <p>
            The <strong>Restore local</strong> job type re-downloads all offloaded
            files back to your server. Useful when switching providers — restore everything,
            configure the new provider, then re-offload.
          </p>
        </section>

        <!-- Switching providers -->
        <section id="switching-providers" class="docs-section">
          <h2>Switching providers</h2>
          <p>
            Because Nimbus stores a relative storage key rather than a full
            provider URL, switching providers is straightforward:
          </p>
          <ol>
            <li>
              Run a <strong>Restore local</strong> job to bring all files back to
              your server.
            </li>
            <li>
              Go to <strong>Nimbus → Settings → Storage</strong> and select the new
              provider. Enter your new credentials and test the connection.
            </li>
            <li>
              Run a <strong>Bulk offload</strong> job to push everything to the new
              bucket.
            </li>
          </ol>
          <p>
            If you are only changing the CDN domain (same provider, different
            front-end URL), simply update the <strong>Custom CDN domain</strong> setting.
            No job required — all URLs update immediately via the settings toggle.
          </p>
        </section>

        <!-- Restoring files -->
        <section id="restore" class="docs-section">
          <h2>Restoring files</h2>
          <p>
            You can restore individual files or your entire library back to
            local storage at any time.
          </p>
          <ul>
            <li>
              <strong>Single file:</strong> In the Media Library, hover the attachment
              and click <em>Restore to local</em> from the Nimbus row action.
            </li>
            <li>
              <strong>Bulk restore:</strong> Go to <strong>Nimbus → Jobs</strong
              >
              and start a <em>Restore local</em> job. Every offloaded file is re-downloaded
              and all database writes from the original offload are reversed.
            </li>
          </ul>
          <p>
            After a restore, a file is treated as a brand new local attachment —
            it will be re-offloaded on the next upload or bulk job if
            <em>Offload New Uploads</em> is enabled.
          </p>
        </section>

        <!-- Key settings -->
        <section id="settings" class="docs-section">
          <h2>Key settings</h2>

          <h3>General</h3>
          <div class="docs-table-wrap">
            <table>
              <thead>
                <tr><th>Setting</th><th>What it does</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>Offload New Uploads</code></td>
                  <td
                    >Automatically send files to the cloud as they are uploaded.
                    On by default.</td
                  >
                </tr>
                <tr>
                  <td><code>Serve From Storage</code></td>
                  <td
                    >Rewrite all attachment URLs to your bucket or CDN domain.
                    Toggle off to serve from disk instantly without changing any
                    data.</td
                  >
                </tr>
                <tr>
                  <td><code>Remove Local Copies</code></td>
                  <td
                    >Delete the local file after a successful offload to free up
                    server disk space. Enable only after you have verified
                    offloads are working.</td
                  >
                </tr>
                <tr>
                  <td><code>Custom CDN domain</code></td>
                  <td
                    >Serve media from your own CDN subdomain (e.g. <code
                      >cdn.yoursite.com</code
                    >) instead of directly from the bucket URL.</td
                  >
                </tr>
                <tr>
                  <td><code>Bucket path prefix</code></td>
                  <td
                    >A folder prefix inside the bucket (e.g. <code
                      >wp-uploads/</code
                    >). Useful when sharing a bucket with other apps.</td
                  >
                </tr>
              </tbody>
            </table>
          </div>

          <h3>Selective offload</h3>
          <p>
            Control exactly which files get offloaded. Find these under
            <strong>Settings → Offload rules</strong>:
          </p>
          <div class="docs-table-wrap">
            <table>
              <thead>
                <tr><th>Rule</th><th>How it works</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td>Minimum file size</td>
                  <td
                    >Skip files smaller than a given size (in KB). Handy for
                    ignoring tiny thumbnails or icons.</td
                  >
                </tr>
                <tr>
                  <td>MIME type filter</td>
                  <td
                    >Only offload files matching specific MIME patterns (e.g. <code
                      >image/*</code
                    >, <code>video/mp4</code>). Leave empty for all types.</td
                  >
                </tr>
                <tr>
                  <td>Path allow-list</td>
                  <td
                    >Only paths matching this glob pattern are offloaded. Empty
                    means all paths are allowed.</td
                  >
                </tr>
                <tr>
                  <td>Path deny-list</td>
                  <td
                    >Paths matching this glob are never offloaded. Takes
                    priority over the allow-list.</td
                  >
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Nightly scheduling -->
        <section id="nightly" class="docs-section">
          <h2>Nightly off-hours scheduling</h2>
          <p>
            Large libraries can take hours to migrate. The nightly scheduler
            runs that work automatically at a configured time — by default 3 AM
            — so your server resources are free during peak traffic hours.
          </p>
          <p>
            Configure it under <strong>Nimbus → Settings → Nightly batch</strong
            >:
          </p>
          <ul>
            <li>
              <strong>Run time</strong> — the hour each night the batch starts (your
              server's local time).
            </li>
            <li>
              <strong>Parallel workers</strong> — how many simultaneous workers process
              the queue, up to 8.
            </li>
            <li>
              <strong>Batch size per worker</strong> — how many files each worker
              handles per tick.
            </li>
          </ul>
          <p>
            The scheduler drains the pending-offload queue automatically each
            night. No bulk job needs to be manually started — if files are
            waiting to be offloaded, the nightly run processes them.
          </p>
        </section>

        <!-- Cache purge -->
        <section id="cache-purge" class="docs-section">
          <h2>Cache purge</h2>
          <p>
            After an offload or URL rewrite, cached copies of your old URLs can
            serve stale content. Nimbus fires purge requests automatically so
            visitors always get the current version.
          </p>
          <p>
            Configure your cache provider under <strong
              >Nimbus → Settings → Cache purge</strong
            >. Supported integrations:
          </p>
          <div class="docs-cards">
            <div class="docs-card">
              <h3>Cloudflare</h3>
              <p>
                Purges URLs via the Cloudflare Cache API v4. Supports both
                per-URL purge and zone-wide purge.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>Zone ID, API token with Cache Purge permission</dd>
              </dl>
            </div>
            <div class="docs-card">
              <h3>LiteSpeed Cache</h3>
              <p>
                Hooks into LiteSpeed Cache's built-in purge actions. No
                credentials needed — just activate in Nimbus.
              </p>
            </div>
            <div class="docs-card">
              <h3>WP Fastest Cache</h3>
              <p>
                Hooks into WP Fastest Cache for per-URL and full-cache clears.
                No credentials needed.
              </p>
            </div>
            <div class="docs-card">
              <h3>Proxy / Nginx</h3>
              <p>
                Sends an HTTP PURGE request to a configurable URL template.
                Supports variables: <code>&#123;url&#125;</code>, <code
                  >&#123;path&#125;</code
                >, <code>&#123;host&#125;</code>, <code>&#123;scheme&#125;</code
                >.
              </p>
              <dl>
                <dt>Required</dt>
                <dd>PURGE endpoint template URL</dd>
              </dl>
            </div>
          </div>
          <p>
            Purges fire automatically on three events: after a file is
            offloaded, after the <em>Serve from Storage</em> toggle is changed, and
            after a plugin integration rewrite completes. Requests are batched (5
            per tick by default) so they don't block page loads.
          </p>
        </section>

        <!-- Plugin integrations -->
        <section id="integrations" class="docs-section">
          <h2>Plugin integrations</h2>
          <p>
            If you use a page builder or gallery plugin, your database likely
            contains URLs pointing at your old local upload path embedded in
            JSON metadata. Nimbus can rewrite those too — with a single click
            per integration.
          </p>
          <p>
            Go to <strong>Nimbus → Integrations</strong>. Nimbus auto-detects
            which of the following plugins are active and shows a
            <strong>Rewrite URLs</strong> button for each:
          </p>
          <div class="docs-table-wrap">
            <table>
              <thead>
                <tr><th>Plugin</th><th>What gets rewritten</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td>Elementor</td>
                  <td
                    ><code>_elementor_data</code> and <code
                      >_elementor_page_settings</code
                    > postmeta (JSON payload)</td
                  >
                </tr>
                <tr>
                  <td>Slider Revolution</td>
                  <td>All <code>revslider_*</code> database tables</td>
                </tr>
                <tr>
                  <td>Smart Slider 3</td>
                  <td>Nextend storage tables and placeholder values</td>
                </tr>
                <tr>
                  <td>NextGEN Gallery</td>
                  <td>All <code>ngg_*</code> database tables</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p>
            You only need to run the rewrite once per integration after your
            initial bulk migration. The rewrite is idempotent — running it again
            is harmless.
          </p>
        </section>

        <!-- WooCommerce -->
        <section id="woocommerce" class="docs-section">
          <h2>WooCommerce downloads</h2>
          <p>
            If you sell downloadable products in WooCommerce and the file is
            stored in the cloud, Nimbus automatically replaces the download URL
            with a short-lived <strong>signed URL</strong> that points directly to
            your storage provider. The buyer's browser redirects straight to the file
            — your web server is bypassed entirely, saving bandwidth and load time.
          </p>
          <p>
            This happens automatically for any offloaded attachment. Signed URLs
            expire after 1 hour by default. No additional setup required beyond
            having WooCommerce active and your files offloaded.
          </p>
          <div class="docs-callout">
            <strong>Supported providers:</strong> Amazon S3, Cloudflare R2, Google
            Cloud Storage, and any provider whose adapter exposes a presign method.
            Check the Integrations tab in Nimbus to confirm your provider supports
            presigned URLs.
          </div>
        </section>

        <!-- Multisite -->
        <section id="multisite" class="docs-section">
          <h2>WordPress Multisite</h2>
          <p>
            Nimbus works on WordPress Multisite. Each sub-site in the network
            has its own independent Nimbus settings — configured via the
            individual site's admin panel, just like a regular install.
          </p>
          <p>
            Super-admins can see a bird's-eye view of all sites at once in the
            <strong>Network Admin → Nimbus</strong> panel, which shows offload
            statistics for every site in the network.
          </p>
          <div class="docs-callout">
            There's no per-site activation limit — Nimbus works the same way
            on every sub-site, free of charge.
          </div>
        </section>

        <!-- Config export & import -->
        <section id="config-backup" class="docs-section">
          <h2>Config export &amp; import</h2>
          <p>
            Go to <strong>Nimbus → Settings → Advanced</strong> to export your entire
            Nimbus configuration as a JSON file. You can then import that file on
            another site to replicate the setup instantly — useful for:
          </p>
          <ul>
            <li>Copying a staging environment's settings to production</li>
            <li>Setting up a new site with the same provider credentials</li>
            <li>
              Keeping a backup of your configuration before making changes
            </li>
          </ul>
          <div class="docs-callout">
            <strong>Security note:</strong> The exported file contains your storage
            credentials. Store it safely and do not commit it to version control.
          </div>
        </section>

        <!-- WP-CLI -->
        <section id="cli" class="docs-section">
          <h2>WP-CLI</h2>
          <p>
            All commands are under the <code>nimbus</code> namespace.
          </p>
          <div class="docs-table-wrap">
            <table>
              <thead>
                <tr><th>Command</th><th>What it does</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>wp nimbus deploy [IDs] [--limit=N]</code></td>
                  <td
                    >Offload specific attachments by ID, or all unoffloaded
                    attachments if no IDs given.</td
                  >
                </tr>
                <tr>
                  <td
                    ><code
                      >wp nimbus process-pending [--hours=24] [--limit=500]</code
                    ></td
                  >
                  <td
                    >Drain the pending queue — re-tries any files that failed or
                    were skipped.</td
                  >
                </tr>
                <tr>
                  <td><code>wp nimbus download [IDs] [--limit=N]</code></td>
                  <td>Restore remote files back to local disk.</td>
                </tr>
                <tr>
                  <td><code>wp nimbus rewrite [--limit=500]</code></td>
                  <td
                    >Replace local upload URLs with remote CDN URLs in post
                    content.</td
                  >
                </tr>
                <tr>
                  <td><code>wp nimbus revert [--limit=500]</code></td>
                  <td
                    >Reverse the rewrite — restore local URLs in post content.</td
                  >
                </tr>
                <tr>
                  <td
                    ><code>wp nimbus replace-urls --from=URL --to=URL</code></td
                  >
                  <td
                    >Arbitrary URL find-and-replace in post content (e.g. after
                    a CDN domain change).</td
                  >
                </tr>
                <tr>
                  <td><code>wp nimbus sync [--limit=N]</code></td>
                  <td
                    >Queue attachments that are missing remote metadata —
                    catches anything that fell through the cracks.</td
