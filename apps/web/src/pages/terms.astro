---
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import Base from "@layouts/Base.astro";
import "@styles/global.css";
import "@styles/tokens.css";
---

<Base
  title="Terms of Use — Nimbus"
  description="Terms and conditions for using the Nimbus WordPress plugin and website."
>
  <Navbar />
  <main id="main-content" class="legal-page">
    <div class="container">
      <a class="back-link" href="/">
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M10 3L5 8l5 5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Back to Nimbus
      </a>

      <article class="legal-article">
        <header class="legal-header">
          <p class="section-label">Legal</p>
          <h1 class="legal-title">Terms of Use</h1>
          <p class="legal-date">Last updated: 4 April 2026</p>
        </header>

        <div class="legal-body">
          <h2>1. Acceptance</h2>
          <p>
            By purchasing, downloading, or using the Nimbus WordPress plugin
            ("Software"), you agree to be bound by these Terms of Use ("Terms").
            If you do not agree, you may not use the Software. These Terms
            govern your use of the Software and the Nimbus website
            (usenimbus.dev).
          </p>

          <h2>2. License grant</h2>
          <p>
            Subject to your compliance with these Terms and payment of the
            applicable license fee, Nimbus grants you a non-exclusive,
            non-transferable, limited license to install and use the Software on
            the number of WordPress sites permitted by your plan:
          </p>
          <ul>
            <li><strong>Personal</strong> — 1 WordPress site.</li>
            <li><strong>Pro</strong> — up to 5 WordPress sites.</li>
            <li>
              <strong>Agency</strong> — unlimited WordPress sites (your sites or client
              sites managed by you).
            </li>
          </ul>
          <p>
            The license is per developer/purchaser and may not be shared with
            other individuals or organisations without a separate license.
          </p>

          <h2>3. Restrictions</h2>
          <p>You may not:</p>
          <ul>
            <li>
              Redistribute, resell, sublicense, or make the Software available
              to third parties without Nimbus's written permission.
            </li>
            <li>
              Remove or alter any license key mechanisms, attribution notices,
              or copyright statements in the Software.
            </li>
            <li>
              Use the Software beyond the site limits of your plan without
              purchasing an appropriate upgrade.
            </li>
            <li>
              Use the Software for any unlawful purpose or in any way that
              violates these Terms.
            </li>
          </ul>

          <h2>4. Updates and support</h2>
          <p>
            An active license entitles you to all minor and patch updates within
            the current major version during the license period. Major version
            upgrades may be offered at a discounted renewal rate. Support is
            provided via email at <a href="mailto:hello@usenimbus.dev"
              >hello@usenimbus.dev</a
            >. We aim to respond to all support requests within 2 business days.
          </p>

          <h2>5. Payment and billing</h2>
          <p>
            All paid plans are sold as <strong>annual subscriptions</strong>.
            Prices are displayed in USD at the time of purchase and are subject
            to applicable taxes. Payments are processed by
            <strong>Razorpay</strong> (razorpay.com) and are subject to Razorpay's
            terms of service.
          </p>
          <p>
            Subscriptions renew automatically at the end of each annual billing
            period. You will receive an email reminder before renewal. By
            completing a purchase you authorise Razorpay to charge your payment
            method for the same plan on each renewal date unless you cancel
            beforehand.
          </p>
          <p>
            To cancel your subscription, email
            <a href="mailto:hello@usenimbus.dev">hello@usenimbus.dev</a> with the
            subject line "Cancel subscription" and include the email address used
            at checkout. Cancellation takes effect at the end of your current billing
            period; your access continues until that date. No partial refunds are
            issued for the unused portion of a prepaid annual period, except where
            required by law or as set out in the Refund Policy below.
          </p>

          <h2>6. Refund and cancellation policy</h2>
          <p>
            We offer a <strong>14-day money-back guarantee</strong> on all first-time
            paid plan purchases. If you are not satisfied, email
            <a href="mailto:hello@usenimbus.dev">hello@usenimbus.dev</a> within 14
            days of your initial payment and we will issue a full refund with no questions
            asked, provided you have not used the license to offload production data
            at significant volume.
          </p>
          <p>
            Refunds are <strong>not</strong> available:
          </p>
          <ul>
            <li>After the 14-day period has elapsed.</li>
            <li>
              For subscription renewals (the reminder email gives you adequate
              notice to cancel).
            </li>
            <li>
              Where the license has been used to process substantial production
              data.
            </li>
          </ul>
          <p>
            Approved refunds are credited back to the original payment method
            within 5–10 business days, subject to Razorpay's processing
            timelines. For the full cancellation procedure and a detailed
            breakdown see our <a href="/refund"
              >Cancellation &amp; Refund Policy</a
            >.
          </p>

          <h2>7. Intellectual property</h2>
          <p>
            The Software, including all code, design, and associated materials,
            is the intellectual property of Nimbus. Your license gives you a
            right to use the Software — it does not transfer ownership. All
            rights not expressly granted are reserved.
          </p>

          <h2>8. Third-party services</h2>
          <p>
            The Software integrates with third-party cloud storage providers
            (Amazon S3, Cloudflare R2, etc.) and cache plugins. Your use of
            those services is governed by their respective terms and privacy
            policies. Nimbus is not responsible for the actions, availability,
            or data handling practices of any third-party provider.
          </p>

          <h2>9. Disclaimer of warranties</h2>
          <p>
            THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
            EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO WARRANTIES OF
            MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND
            NON-INFRINGEMENT. NIMBUS DOES NOT WARRANT THAT THE SOFTWARE WILL BE
            ERROR-FREE, UNINTERRUPTED, OR FREE OF SECURITY VULNERABILITIES.
          </p>

          <h2>10. Limitation of liability</h2>
          <p>
            TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, IN NO EVENT SHALL
            NIMBUS BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL,
            CONSEQUENTIAL, OR PUNITIVE DAMAGES, INCLUDING LOSS OF DATA, REVENUE,
            OR PROFITS, ARISING OUT OF OR RELATED TO YOUR USE OF THE SOFTWARE.
            IN ANY CASE, NIMBUS'S TOTAL AGGREGATE LIABILITY SHALL NOT EXCEED THE
            AMOUNT YOU PAID FOR YOUR LICENSE IN THE 12 MONTHS PRECEDING THE
            CLAIM.
          </p>

          <h2>11. Termination</h2>
          <p>
            We may terminate or suspend your license immediately if you breach
            these Terms. Upon termination, you must cease using the Software and
            delete all copies in your possession. Sections that by their nature
            should survive termination (Intellectual Property, Disclaimer,
            Limitation of Liability, Governing Law) will do so.
          </p>

          <h2>12. Governing law</h2>
          <p>
            These Terms shall be governed by and construed in accordance with
            applicable law. Any disputes arising under these Terms shall be
            resolved through good-faith negotiation first, and failing that,
            through the competent courts of the developer's jurisdiction. The UN
            Convention on the International Sale of Goods does not apply.
          </p>

          <h2>13. Changes to these terms</h2>
          <p>
            We may update these Terms from time to time. When we do, we will
            update the "last updated" date above. Continued use of the Software
            after changes are posted constitutes acceptance of the revised
            Terms.
          </p>

          <h2>14. Contact</h2>
          <p>
            Questions about these Terms? Email us at <a
              href="mailto:hello@usenimbus.dev">hello@usenimbus.dev</a
            >.
          </p>
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal-page {
    padding: 3.5rem 0 7rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--nmb-text-muted);
    text-decoration: none;
    margin-bottom: 3rem;
    transition: color var(--nmb-t);
  }

  .back-link:hover {
    color: var(--nmb-text);
  }

  /* ── Article ─────────────────────────────────────────────────────────────── */
  .legal-article {
    max-width: 720px;
  }

  .legal-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--nmb-border-light);
  }

  .legal-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 750;
    letter-spacing: -0.028em;
    color: var(--nmb-text);
    margin: 0.5rem 0 0.25rem;
  }

  .legal-date {
    font-size: 0.875rem;
    color: var(--nmb-text-subtle);
    margin: 0;
  }

  /* ── Body typography ─────────────────────────────────────────────────────── */
  .legal-body h2 {
    font-size: 1.0625rem;
    font-weight: 650;
    color: var(--nmb-text);
    letter-spacing: -0.015em;
    margin: 2.25rem 0 0.625rem;
  }

  .legal-body p {
    font-size: 0.9375rem;
    color: var(--nmb-text-muted);
    line-height: 1.75;
    margin: 0 0 0.875rem;
  }

  .legal-body ul {
    margin: 0 0 0.875rem 1.25rem;
    padding: 0;
  }

  .legal-body li {
    font-size: 0.9375rem;
    color: var(--nmb-text-muted);
    line-height: 1.75;
    margin-bottom: 0.3rem;
  }

  .legal-body strong {
    color: var(--nmb-text-2);
    font-weight: 600;
  }

  .legal-body a {
    color: var(--nmb-accent);
    text-decoration: none;
  }

  .legal-body a:hover {
    text-decoration: underline;
  }
</style>
