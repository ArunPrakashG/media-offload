---
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import Base from "@layouts/Base.astro";
import "@styles/global.css";
import "@styles/tokens.css";
---

<Base
  title="Refunds — Nimbus"
  description="Nimbus is free and open source — there are no purchases and no refunds to process."
>
  <Navbar />
  <main id="main-content" class="legal-page">
    <div class="container">
      <a class="back-link" href="/">
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M10 3L5 8l5 5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Back to Nimbus
      </a>

      <article class="legal-article">
        <header class="legal-header">
          <p class="section-label">Legal</p>
          <h1 class="legal-title">Refunds</h1>
          <p class="legal-date">Last updated: 28 July 2026</p>
        </header>

        <div class="legal-body">
          <p>
            Nimbus is <strong>100% free and open source</strong>. There are no
            paid plans, no purchases, and no subscriptions — so there is
            nothing to refund.
          </p>
          <p>
            If you previously purchased a Nimbus license before the plugin
            became free, that license is no longer needed: every feature is
            now available to everyone at no cost, with no license key
            required.
          </p>
          <p>
            Questions? Email <a href="mailto:hello@usenimbus.dev"
              >hello@usenimbus.dev</a
            >.
          </p>
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal-page {
    padding: 3.5rem 0 7rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--nmb-text-muted);
    text-decoration: none;
    margin-bottom: 3rem;
    transition: color var(--nmb-t);
  }

  .back-link:hover {
    color: var(--nmb-text);
  }

  .legal-article {
    max-width: 720px;
  }

  .legal-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--nmb-border-light);
  }

  .legal-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 750;
    letter-spacing: -0.028em;
    color: var(--nmb-text);
    margin: 0.5rem 0 0.25rem;
  }

  .legal-date {
    font-size: 0.875rem;
    color: var(--nmb-text-subtle);
    margin: 0;
  }

  .legal-body h2 {
    font-size: 1.0625rem;
    font-weight: 650;
    color: var(--nmb-text);
    letter-spacing: -0.015em;
    margin: 2.25rem 0 0.625rem;
  }

  .legal-body h3 {
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--nmb-text);
    margin: 1.5rem 0 0.5rem;
  }

  .legal-body p {
    font-size: 0.9375rem;
    color: var(--nmb-text-muted);
    line-height: 1.75;
    margin: 0 0 0.875rem;
  }

  .legal-body ul,
  .legal-body ol {
    margin: 0 0 0.875rem 1.25rem;
    padding: 0;
  }

  .legal-body li {
    font-size: 0.9375rem;
    color: var(--nmb-text-muted);
    line-height: 1.75;
    margin-bottom: 0.3rem;
  }

  .legal-body strong {
    color: var(--nmb-text-2);
    font-weight: 600;
  }

  .legal-body a {
    color: var(--nmb-accent);
    text-decoration: none;
  }

  .legal-body a:hover {
    text-decoration: underline;
  }
</style>
