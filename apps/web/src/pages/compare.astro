    <!-- Competitor comparison section -->
    <section class="section section--alt">
      <div class="container">
        <h2 class="section-headline" style="margin-bottom:0.75rem">
          How Nimbus compares to the market leader
        </h2>
        <p class="section-sub" style="margin-bottom:2.5rem">
          The most popular WordPress media offload plugin on the market. Here's where Nimbus wins
