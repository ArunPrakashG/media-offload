---
// Prices shown to the user — annual billing in USD via Razorpay.
const plans = [
  {
    key: "personal",
    name: "Personal",
    price: "$69",
    sites: "1 WordPress site",
    badge: null,
    accent: false,
    free: false,
    features: [
      "Unlimited media files",
      "1 WordPress installation",
      "Any S3-compatible provider",
      "Database URL rewriting",
      "Bulk migration tool",
      "Nightly batch offloading",
      "Email support",
    ],
    cta: "Get started",
  },
  {
    key: "pro",
    name: "Pro",
    price: "$169",
    sites: "Up to 5 sites",
    badge: "Most popular",
    accent: true,
    free: false,
    features: [
      "Everything in Personal",
      "5 WordPress installations",
      "WordPress Multisite support",
      "WP-CLI support",
      "Priority email support",
    ],
    cta: "Get started",
  },
  {
    key: "agency",
    name: "Agency",
    price: "$449",
    sites: "Unlimited sites",
    badge: null,
    accent: false,
    free: false,
    features: [
      "Everything in Pro",
      "Unlimited installations",
      "Cache purge integration",
      "Priority support + onboarding",
    ],
    cta: "Get started",
  },
];
---

<section class="section pricing" id="pricing">
  <div class="container">
    <div class="pricing-header">
      <p class="section-label">Pricing</p>
      <h2 class="section-headline">
        Simple pricing.<br />No media file caps.
      </h2>
      <p class="section-sub">
        Paid plans billed annually in USD. Unlimited media files on every plan —
        pay by the number of sites you run, not how much you upload.
        <a href="/compare" class="compare-link"
          >How does this compare to per-file pricing plugins? →</a
        >
      </p>
    </div>

    <!-- Free-tier informational strip -->
    <div class="free-strip">
      <div class="free-strip-icon" aria-hidden="true">✦</div>
      <div class="free-strip-body">
        <p class="free-strip-headline">Free tier included</p>
        <p class="free-strip-sub">
          Every install ships with a free tier — new-upload offloading, database
          URL rewriting, and any S3-compatible provider on 1 site with unlimited
          media. No credit card. No time limit. <strong
            >Activated automatically when you install the plugin.</strong
          >
        </p>
      </div>
    </div>

    <div class="pricing-grid">
      {
        plans.map((plan) => (
          <div class:list={["plan-card", plan.accent && "plan-card--accent"]}>
            {plan.badge && <div class="plan-badge">{plan.badge}</div>}

            <div class="plan-top">
              <span class="plan-name">{plan.name}</span>
              <span class="plan-sites">{plan.sites}</span>
            </div>

            <div class="plan-price-row">
              <span class="plan-price">{plan.price}</span>
              <div class="plan-period-group">
                <span class="plan-period">/ yr</span>
              </div>
            </div>

            <div class="plan-divider" />

            <ul class="plan-features">
              {plan.features.map((f) => (
                <li class="plan-feature">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                    class="plan-check"
                  >
                    <circle
                      cx="8"
                      cy="8"
                      r="7"
                      fill="var(--nmb-accent-light)"
                      stroke="rgba(79,99,245,.2)"
                    />
                    <path
                      d="M5 8l2 2 4-4"
                      stroke="var(--nmb-accent)"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <button
              class:list={[
                "plan-btn",
                plan.accent ? "btn btn-primary" : "btn btn-ghost",
              ]}
              data-plan={plan.key}
              type="button"
            >
              <span class="plan-btn-label">{plan.cta}</span>
              <span class="plan-btn-spinner" aria-hidden="true" />
            </button>
          </div>
        ))
      }
    </div>

    <p class="pricing-footer">
      <svg
        width="13"
        height="13"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"
        ></circle>
        <path
          d="M8 7v4M8 5.5v.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"></path>
      </svg>
      14-day money-back guarantee on paid plans &nbsp;·&nbsp; Annual billing, cancel
      any time &nbsp;·&nbsp; Instant license delivery &nbsp;·&nbsp; <a
        href="/compare"
        style="color:inherit">No media file caps →</a
      >
    </p>
  </div>
</section>

<!-- Email collection dialog — opens before Razorpay checkout -->
<dialog
  id="email-dialog"
  class="email-dialog"
  aria-labelledby="email-dialog-title"
>
  <form method="dialog" class="email-dialog-form" id="email-form">
    <h3 id="email-dialog-title" class="email-dialog-title">
      Where should we send your license?
    </h3>
    <p class="email-dialog-sub">
      Your license key will be emailed to you right after payment.
    </p>
    <label class="email-label" for="checkout-email">Email address</label>
    <input
      id="checkout-email"
      type="email"
      class="email-input"
      placeholder="you@example.com"
      required
      autocomplete="email"
    />
    <div class="email-dialog-actions">
      <button class="btn btn-ghost" type="button" id="email-dialog-cancel"
        >Cancel</button
      >
      <button class="btn btn-primary" type="submit" id="email-dialog-submit">
        <span id="email-submit-label">Continue to payment</span>
        <span
          class="plan-btn-spinner"
          id="email-submit-spinner"
          aria-hidden="true"
          hidden></span>
      </button>
    </div>
    <p class="email-dialog-error" id="email-dialog-error" hidden></p>
  </form>
</dialog>

<!-- Payment result overlay -->
<div
  id="pay-overlay"
  class="pay-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pay-overlay-title"
  hidden
>
  <div class="pay-overlay-card">
    <div
      class="pay-overlay-icon pay-overlay-icon--success"
      id="pay-icon-success"
      hidden
    >
      <svg
        width="28"
        height="28"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
      >
        <circle
          cx="16"
          cy="16"
          r="14"
          fill="var(--nmb-accent-light)"
          stroke="rgba(79,99,245,.3)"></circle>
        <path
          d="M10 16l4 4 8-8"
          stroke="var(--nmb-accent)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>
    <div
      class="pay-overlay-icon pay-overlay-icon--error"
      id="pay-icon-error"
      hidden
    >
      <svg
        width="28"
        height="28"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
      >
        <circle
          cx="16"
          cy="16"
          r="14"
          fill="#fef2f2"
          stroke="rgba(239,68,68,.3)"></circle>
        <path
          d="M11 11l10 10M21 11l-10 10"
          stroke="#ef4444"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </div>
    <h3 class="pay-overlay-title" id="pay-overlay-title"></h3>
    <p class="pay-overlay-msg" id="pay-overlay-msg"></p>
    <button class="btn btn-ghost" id="pay-overlay-close" type="button"
      >Close</button
    >
  </div>
</div>

<style>
  /* ── Section header ──────────────────────────────────────────────────────── */
  .pricing-header {
    max-width: 540px;
    margin-bottom: 3.5rem;
  }

  .pricing-header .section-label {
    margin-bottom: 0.625rem;
  }
  .pricing-header .section-headline {
    margin-bottom: 1rem;
  }
  .pricing-header .section-sub {
    margin-bottom: 1.75rem;
  }

  .compare-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--nmb-accent);
    text-decoration: none;
  }
  .compare-link:hover {
    text-decoration: underline;
  }

  /* ── Billing toggle ───────────────────────────────────────────────────────── */
  .billing-toggle {
    display: inline-flex;
    background: var(--nmb-bg-subtle, rgba(0, 0, 0, 0.04));
    border: 1px solid var(--nmb-border);
    border-radius: var(--nmb-radius-full);
    padding: 3px;
    gap: 2px;
  }

  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 1rem;
    border-radius: var(--nmb-radius-full);
    border: none;
    background: transparent;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--nmb-text-subtle);
    cursor: pointer;
    transition:
      background var(--nmb-t),
      color var(--nmb-t),
      box-shadow var(--nmb-t);
  }

  .toggle-btn--active {
    background: var(--nmb-surface);
    color: var(--nmb-text);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  }

  .toggle-save {
    font-size: 0.6875rem;
    font-weight: 650;
    color: #16a34a;
    background: #dcfce7;
    padding: 0.1rem 0.45rem;
    border-radius: var(--nmb-radius-full);
  }

  /* ── Free-tier strip ────────────────────────────────────────────────────── */
  .free-strip {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: var(--nmb-surface);
    border: 1px solid var(--nmb-border);
    border-radius: var(--nmb-radius-lg);
    padding: 1.25rem 1.75rem;
    margin-bottom: 2rem;
  }

  .free-strip-icon {
    font-size: 1.25rem;
    color: var(--nmb-accent, #6366f1);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .free-strip-headline {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--nmb-text);
    margin: 0 0 0.3rem;
  }

  .free-strip-sub {
    font-size: 0.875rem;
    color: var(--nmb-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Grid ───────────────────────────────────────────────────────────────── */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }

  /* ── Card ───────────────────────────────────────────────────────────────── */
  .plan-card {
    position: relative;
    background: var(--nmb-surface);
    border: 1px solid var(--nmb-border);
    border-radius: var(--nmb-radius-lg);
    padding: 2rem 1.875rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    transition:
      box-shadow var(--nmb-t),
      border-color var(--nmb-t);
  }

  .plan-card:hover {
    box-shadow: var(--nmb-shadow-md);
  }

  /* Accent (Pro) card */
  .plan-card--accent {
    border-color: var(--nmb-accent);
    box-shadow: var(--nmb-shadow-accent);
  }

  .plan-card--accent::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--nmb-accent-dim);
    pointer-events: none;
  }

  .plan-card--accent:hover {
    box-shadow: 0 12px 36px rgba(79, 99, 245, 0.28);
  }

  /* ── Badge ───────────────────────────────────────────────────────────────── */
  .plan-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--nmb-surface);
    background: var(--nmb-accent);
    padding: 0.2rem 0.75rem;
    border-radius: var(--nmb-radius-full);
    white-space: nowrap;
    box-shadow: var(--nmb-shadow-accent);
  }

  /* ── Top row ─────────────────────────────────────────────────────────────── */
  .plan-top {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .plan-name {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--nmb-text);
  }

  .plan-sites {
    font-size: 0.8125rem;
    color: var(--nmb-text-subtle);
    font-weight: 450;
  }

  /* ── Price ───────────────────────────────────────────────────────────────── */
  .plan-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .plan-price {
    font-size: clamp(1.875rem, 3vw, 2.25rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    color: var(--nmb-text);
    line-height: 1;
    transition: opacity 0.15s;
  }

  .plan-period-group {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .plan-period {
    font-size: 0.8125rem;
    color: var(--nmb-text-subtle);
  }

  .plan-annual-note {
    font-size: 0.75rem;
    color: var(--nmb-text-subtle);
  }

  /* ── Divider ─────────────────────────────────────────────────────────────── */
  .plan-divider {
    height: 1px;
    background: var(--nmb-border-light);
    margin: 0 -0.25rem;
  }

  /* ── Features ────────────────────────────────────────────────────────────── */
  .plan-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }

  .plan-feature {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--nmb-text-2);
    line-height: 1.45;
  }

  .plan-check {
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* ── Button ──────────────────────────────────────────────────────────────── */
  .plan-btn {
    width: 100%;
    justify-content: center;
    cursor: pointer;
    position: relative;
  }

  .plan-btn[data-loading] .plan-btn-label {
    opacity: 0;
  }

  .plan-btn-spinner {
    display: none;
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    opacity: 0.7;
  }

  .plan-btn[data-loading] .plan-btn-spinner {
    display: block;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── Footer note ─────────────────────────────────────────────────────────── */
  .pricing-footer {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    justify-content: center;
    margin-top: 2.25rem;
    font-size: 0.8125rem;
    color: var(--nmb-text-subtle);
  }

  /* ── Email dialog ────────────────────────────────────────────────────────── */
  .email-dialog {
    border: 1px solid var(--nmb-border);
    border-radius: var(--nmb-radius-xl);
    box-shadow: var(--nmb-shadow-lg);
    padding: 2rem;
    max-width: 400px;
    width: calc(100vw - 2rem);
    background: var(--nmb-surface);
    color: var(--nmb-text);
    /* showModal() puts the dialog in the top layer; margin:auto centers it. */
    margin: auto;
  }

  .email-dialog::backdrop {
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(4px);
  }

  .email-dialog-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .email-dialog-title {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .email-dialog-sub {
    font-size: 0.9rem;
    color: var(--nmb-text-subtle);
    margin: 0;
  }

  .email-label {
    font-size: 0.875rem;
    font-weight: 500;
    display: block;
    margin-bottom: 0.3rem;
  }

  .email-input {
    width: 100%;
    padding: 0.6rem 0.875rem;
    border: 1px solid var(--nmb-border);
    border-radius: var(--nmb-radius);
    background: var(--nmb-bg, #fff);
    color: var(--nmb-text);
    font-size: 0.9375rem;
    outline: none;
    box-sizing: border-box;
  }

  .email-input:focus {
    border-color: var(--nmb-accent);
    box-shadow: 0 0 0 3px var(--nmb-accent-light);
  }

  .email-dialog-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    margin-top: 0.25rem;
  }

  .email-dialog-error {
    color: #ef4444;
    font-size: 0.875rem;
    margin: 0;
  }

  /* ── Overlay ─────────────────────────────────────────────────────────────── */
  .pay-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 1.5rem;
  }

  .pay-overlay[hidden] {
    display: none;
  }

  .pay-overlay-card {
    background: var(--nmb-surface);
    border: 1px solid var(--nmb-border);
    border-radius: var(--nmb-radius-xl);
    box-shadow: var(--nmb-shadow-lg);
    padding: 2.5rem 2rem;
    max-width: 380px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .pay-overlay-icon {
    display: flex;
  }
  .pay-overlay-icon[hidden] {
    display: none;
  }

  .pay-overlay-title {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--nmb-text);
    margin: 0;
  }

  .pay-overlay-msg {
    font-size: 0.9375rem;
    color: var(--nmb-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
    }

    .plan-card--accent {
      order: -1;
    }
  }
</style>

<script>
  // ── Helpers ───────────────────────────────────────────────────────────────
  function loadRazorpayScript() {
    if (typeof window.Razorpay !== "undefined") return Promise.resolve(true);
    return new Promise((resolve) => {
      const s = document.createElement("script");
      s.src = "https://checkout.razorpay.com/v1/checkout.js";
      s.onload = () => resolve(true);
      s.onerror = () => resolve(false);
      document.head.appendChild(s);
    });
  }

  function showOverlay(type, title, msg) {
    document.getElementById("pay-icon-success").hidden = type !== "success";
    document.getElementById("pay-icon-error").hidden = type !== "error";
    document.getElementById("pay-overlay-title").textContent = title;
    document.getElementById("pay-overlay-msg").textContent = msg;
    document.getElementById("pay-overlay").hidden = false;
  }

  document.getElementById("pay-overlay-close").addEventListener("click", () => {
    document.getElementById("pay-overlay").hidden = true;
  });

  // ── Email dialog ──────────────────────────────────────────────────────────
  const emailDialog = /** @type {HTMLDialogElement} */ (
    document.getElementById("email-dialog")
  );
  const emailInput = /** @type {HTMLInputElement} */ (
    document.getElementById("checkout-email")
  );
  const emailError = document.getElementById("email-dialog-error");
  const emailSubmitBtn = document.getElementById("email-dialog-submit");
  const emailSubmitLabel = document.getElementById("email-submit-label");
  const emailSubmitSpinner = document.getElementById("email-submit-spinner");

  document
    .getElementById("email-dialog-cancel")
    .addEventListener("click", () => {
      emailDialog.close();
    });

  // Close when clicking on the backdrop (outside the dialog box).
  emailDialog.addEventListener("click", (e) => {
    const rect = emailDialog.getBoundingClientRect();
    const clickedOutside =
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom;
    if (clickedOutside) emailDialog.close();
  });

  let pendingPlan = null;

  // Collect email then proceed to payment (paid plans only).
  document.querySelectorAll("[data-plan]").forEach((btn) => {
    btn.addEventListener("click", () => {
      pendingPlan = btn.dataset.plan;
      emailInput.value = "";
      emailError.hidden = true;
      emailDialog.showModal();
    });
  });

  document
    .getElementById("email-form")
    .addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!pendingPlan) return;

      const email = emailInput.value.trim();
      const billingCycle = "annual";
      const plan = pendingPlan;

      emailError.hidden = true;
      emailSubmitLabel.textContent = "Creating subscription…";
      emailSubmitSpinner.hidden = false;
      emailSubmitBtn.disabled = true;

      const reset = () => {
        emailSubmitLabel.textContent = "Continue to payment";
        emailSubmitSpinner.hidden = true;
        emailSubmitBtn.disabled = false;
      };

      // Step 1 — Create subscription server-side
      let subResp = null;
      try {
        subResp = await fetch("/api/create-subscription", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ plan, billing_cycle: billingCycle, email }),
        });
      } catch (_) {
        /* network error */
      }

      if (!subResp?.ok) {
        const err = await subResp?.json().catch(() => ({}));
        emailError.textContent =
          err?.error ?? "Could not start checkout. Please try again.";
        emailError.hidden = false;
        reset();
        return;
      }

      const sub = await subResp.json();
      emailDialog.close();
      reset();

      // Step 2 — Load Razorpay SDK lazily and open the subscription checkout
      const loaded = await loadRazorpayScript();
      if (!loaded) {
        showOverlay(
          "error",
          "Could not load payment gateway",
          "Please disable any ad-blockers or try a different browser.",
        );
        return;
      }

      const rzp = new window.Razorpay({
        key: sub.keyId,
        subscription_id: sub.subscriptionId,
        name: "Nimbus",
        description: `${sub.planLabel} Plan — Annual`,
        image: "/favicon.svg",
        prefill: { email },
        theme: { color: "#4f63f5" },

        handler: async (response) => {
          // Step 3 — Verify subscription payment signature server-side
          let verifyResp = null;
          try {
            verifyResp = await fetch("/api/verify-payment", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                subscriptionId: response.razorpay_subscription_id,
                paymentId: response.razorpay_payment_id,
                signature: response.razorpay_signature,
                plan,
                billingCycle,
                email,
              }),
            });
          } catch (_) {
            /* network error */
          }

          if (!verifyResp?.ok) {
            showOverlay(
              "error",
              "Verification failed",
              "Payment was captured but verification failed. Email hello@usenimbus.dev with your payment ID and we'll sort it out immediately.",
            );
            return;
          }

          showOverlay(
            "success",
            "Subscription activated!",
            "Check your inbox — your license key is on its way. It may take a few minutes.",
          );
        },

        modal: { ondismiss: () => {} },
      });

      rzp.open();
    });
</script>
