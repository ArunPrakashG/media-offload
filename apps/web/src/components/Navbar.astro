---
const links = [
  { label: "Features", href: "#features" },
  { label: "How it works", href: "#how-it-works" },
  { label: "Contact", href: "mailto:hello@usenimbus.dev" },
];
---

<header class="navbar" id="navbar">
  <div class="container navbar-inner">
    <!-- Logo -->
    <a class="navbar-logo" href="/" aria-label="Nimbus">
      <svg
        width="28"
        height="28"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
      >
        <rect width="32" height="32" rx="8" fill="#4f63f5"></rect>
        <path
          d="M7 20.5c0-2.8 2-5 4.8-5.4A6.5 6.5 0 0 1 22.5 14a4.5 4.5 0 0 1 2.5 8.2"
          stroke="#fff"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M13 22.5l3-3.8 3 3.8"
          stroke="#fff"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <line
          x1="16"
          y1="18.7"
          x2="16"
          y2="26"
          stroke="#fff"
          stroke-width="1.75"
          stroke-linecap="round"></line>
      </svg>
      <span>Nimbus</span>
    </a>

    <!-- Nav links -->
    <nav class="navbar-links" aria-label="Main navigation">
      {
        links.map((l) => (
          <a class="navbar-link" href={l.href}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <a class="btn btn-primary navbar-cta" href="mailto:hello@usenimbus.dev">
      Get started
      <svg
        width="14"
        height="14"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>

    <!-- Mobile menu button -->
    <button
      class="navbar-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      id="navbar-toggle"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 5h14M3 10h14M3 15h14"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div class="navbar-mobile" id="navbar-mobile" aria-hidden="true">
    {
      links.map((l) => (
        <a class="navbar-mobile-link" href={l.href}>
          {l.label}
        </a>
      ))
    }
    <a
      class="btn btn-primary"
      style="margin-top:.5rem"
      href="mailto:hello@usenimbus.dev"
    >
      Get started →
    </a>
  </div>
</header>

<style>
  /* ── Shell ──────────────────────────────────────────────────────────────── */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--nmb-border-light);
    transition:
      border-color var(--nmb-t),
      box-shadow var(--nmb-t);
  }

  .navbar.scrolled {
    border-bottom-color: var(--nmb-border);
    box-shadow: var(--nmb-shadow-sm);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 62px;
  }

  /* ── Logo ───────────────────────────────────────────────────────────────── */
  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--nmb-text);
    letter-spacing: -0.02em;
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar-logo:hover {
    color: var(--nmb-accent);
  }

  /* ── Links ──────────────────────────────────────────────────────────────── */
  .navbar-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .navbar-link {
    padding: 0.375rem 0.75rem;
    border-radius: var(--nmb-radius-sm);
    font-size: 0.9375rem;
    font-weight: 450;
    color: var(--nmb-text-muted);
    text-decoration: none;
    transition:
      color var(--nmb-t),
      background var(--nmb-t);
  }

  .navbar-link:hover {
    color: var(--nmb-text);
    background: var(--nmb-surface-muted);
  }

  /* ── CTA ────────────────────────────────────────────────────────────────── */
  .navbar-cta {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  /* ── Mobile toggle ──────────────────────────────────────────────────────── */
  .navbar-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: 1px solid var(--nmb-border);
    border-radius: var(--nmb-radius-sm);
    color: var(--nmb-text);
    cursor: pointer;
    margin-left: auto;
  }

  /* ── Mobile drawer ──────────────────────────────────────────────────────── */
  .navbar-mobile {
    display: none;
    flex-direction: column;
    padding: 1rem 1.5rem 1.25rem;
    border-top: 1px solid var(--nmb-border-light);
    background: var(--nmb-surface);
  }

  .navbar-mobile.open {
    display: flex;
  }

  .navbar-mobile-link {
    padding: 0.625rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--nmb-text-2);
    text-decoration: none;
    border-bottom: 1px solid var(--nmb-border-light);
  }

  .navbar-mobile-link:last-of-type {
    border-bottom: none;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .navbar-links {
      display: none;
    }
    .navbar-cta {
      display: none;
    }
    .navbar-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Scroll shadow
  const navbar = document.getElementById("navbar");
  window.addEventListener(
    "scroll",
    () => {
      navbar?.classList.toggle("scrolled", window.scrollY > 8);
    },
    { passive: true },
  );

  // Mobile toggle
  const toggle = document.getElementById("navbar-toggle");
  const mobile = document.getElementById("navbar-mobile");
  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(open));
    mobile?.setAttribute("aria-hidden", String(!open));
  });

  // Close on link click (mobile)
  mobile?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      mobile.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
