---
const steps = [
  {
    num:    '01',
    title:  'Install & activate',
    desc:   'Install Nimbus from the WordPress plugin directory or upload the zip manually. The setup wizard walks you through everything — under a minute, no code required.',
    detail: 'Works with any WordPress host: shared hosting, VPS, WP Engine, Kinsta, and more.',
  },
  {
    num:    '02',
    title:  'Connect your bucket',
    desc:   'Choose a provider, paste in your API credentials, and pick a bucket. Nimbus verifies the connection with a live write test so you know it works before anything moves.',
    detail: "Don't have a bucket yet? Nimbus can create one for you directly from WordPress.",
  },
  {
    num:    '03',
    title:  'Free your server',
    desc:   'From this point on, every new upload goes straight to cloud storage. For your existing library, the bulk migrator moves everything in background batches — no timeouts, no downtime.',
    detail: 'Media URLs rewrite automatically. Visitors never notice a thing.',
  },
];
---

<section class="section hiw" id="how-it-works">
  <div class="container">

    <div class="hiw-header">
      <p class="section-label">How it works</p>
      <h2 class="section-headline">Your images don't belong on your server.</h2>
      <p class="section-sub">
        Media is the heaviest part of every page load — and your web server is the
        worst possible place to store it. Nimbus moves it all to the cloud in three steps.
      </p>
    </div>

    <!-- Steps -->
    <div class="hiw-steps">
      {steps.map((step, i) => (
        <div class="hiw-step">
          <!-- Left: number -->
          <div class="step-num-wrap">
            <span class="step-num">{step.num}</span>
            {i < steps.length - 1 && <span class="step-connector" aria-hidden="true"></span>}
          </div>
          <!-- Right: content -->
          <div class="step-body">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.desc}</p>
            <p class="step-detail">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/>
                <path d="M8 7v4M8 5v.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
              {step.detail}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Header ─────────────────────────────────────────────────────────────── */
  .hiw-header {
    max-width: 520px;
    margin-bottom: 3.5rem;
  }

  .hiw-header .section-label    { margin-bottom: 0.625rem; }
  .hiw-header .section-headline { margin-bottom: 1rem; }

  /* ── Steps list ─────────────────────────────────────────────────────────── */
  .hiw-steps {
    display: flex;
    flex-direction: column;
    max-width: 680px;
  }

  /* ── Single step ─────────────────────────────────────────────────────────── */
  .hiw-step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 0 1.5rem;
  }

  /* ── Number column ──────────────────────────────────────────────────────── */
  .step-num-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--nmb-border);
    background: var(--nmb-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--nmb-font-mono);
    color: var(--nmb-accent);
    letter-spacing: 0.02em;
    flex-shrink: 0;
    transition: border-color var(--nmb-t), background var(--nmb-t);
  }

  .hiw-step:hover .step-num {
    background: var(--nmb-accent-light);
    border-color: var(--nmb-accent);
  }

  .step-connector {
    flex: 1;
    width: 1.5px;
    background: var(--nmb-border);
    margin: 0.375rem 0;
    min-height: 2rem;
  }

  /* ── Content column ─────────────────────────────────────────────────────── */
  .step-body {
    padding-bottom: 2.5rem;
    padding-top: 0.625rem;
  }

  .hiw-step:last-child .step-body { padding-bottom: 0; }

  .step-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--nmb-text);
    letter-spacing: -0.018em;
    margin-bottom: 0.5rem;
  }

  .step-desc {
    font-size: 0.9875rem;
    color: var(--nmb-text-muted);
    line-height: 1.7;
    margin-bottom: 0.625rem;
    max-width: 52ch;
  }

  .step-detail {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--nmb-text-muted);
    line-height: 1.4;
  }

  .step-detail svg { color: var(--nmb-accent); flex-shrink: 0; }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 639px) {
    .hiw-step {
      grid-template-columns: 40px 1fr;
      gap: 0 1rem;
    }

    .step-num {
      width: 36px;
      height: 36px;
      font-size: 0.6875rem;
    }
  }
</style>
