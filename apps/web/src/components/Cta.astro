---

---

<section class="cta-section">
  <div class="container cta-inner">
    <!-- Left column: text -->
    <div class="cta-text">
      <h2 class="cta-headline">Your site will be faster by tomorrow.</h2>
      <p class="cta-sub">
        100% free and open source — no credit card, no license key, no time
        limit. Every feature is included on every install.
      </p>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href="/docs#installation">
          Get Nimbus
          <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn-ghost btn-lg" href="mailto:hello@usenimbus.dev">
          Ask a question
        </a>
      </div>
    </div>

    <!-- Right column: micro-details -->
    <ul class="cta-assurances" aria-label="Included with every plan">
      {
        [
          "100% free — no credit card needed",
          "Unlimited offload operations",
          "Open source — GPL-licensed, source on GitHub",
          "Community support, real humans",
          "Works with any WordPress host",
        ].map((item) => (
          <li class="assurance-item">
            <svg
              width="15"
              height="15"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <circle
                cx="8"
                cy="8"
                r="7"
                fill="var(--nmb-accent-light)"
                stroke="rgba(79,99,245,.2)"
              />
              <path
                d="M5 8l2 2 4-4"
                stroke="var(--nmb-accent)"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cta-section {
    background: var(--nmb-surface-alt);
    border-top: 1px solid var(--nmb-border-light);
    border-bottom: 1px solid var(--nmb-border-light);
    padding: 5rem 0;
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* ── Text ───────────────────────────────────────────────────────────────── */
  .cta-headline {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 750;
    letter-spacing: -0.028em;
    color: var(--nmb-text);
    margin-bottom: 0.875rem;
  }

  .cta-sub {
    font-size: 1.0625rem;
    color: var(--nmb-text-muted);
    line-height: 1.7;
    max-width: 46ch;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  /* ── Assurances list ────────────────────────────────────────────────────── */
  .cta-assurances {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    border-left: 1px solid var(--nmb-border);
    padding-left: 3rem;
  }

  .assurance-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--nmb-text-2);
    font-weight: 450;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .cta-assurances {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--nmb-border);
      padding-top: 2rem;
    }
  }
</style>
