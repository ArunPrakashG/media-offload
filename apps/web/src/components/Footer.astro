---
import { SITE } from '../lib/site';
import Mark from './Mark.astro';

interface Props { wide?: boolean }
const { wide = false } = Astro.props;
---
<footer class:list={['site-footer', { 'is-wide': wide }]}>
  <div class="wrap">
    <div class="footer-brand"><Mark size={22} /><span>Nimbus · MIT License</span></div>
    <nav aria-label="Footer" class="footer-nav">
      <a href="/docs/">Docs</a>
      <a href="/compare/">Compare</a>
      <a href="/changelog/">Changelog</a>
      <a href={SITE.repo}>GitHub</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
  </div>
</footer>
