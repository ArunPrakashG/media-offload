---
const year = new Date().getFullYear();

const links = [
  {
    heading: "Product",
    items: [
      { label: "Features", href: "#features" },
      { label: "How it works", href: "#how-it-works" },
      {
        label: "Changelog",
        href: "https://github.com/ArunPrakashG/media-offload/releases",
      },
      {
        label: "GitHub",
        href: "https://github.com/ArunPrakashG/media-offload",
      },
    ],
  },
  {
    heading: "Support",
    items: [
      {
        label: "Documentation",
        href: "https://github.com/ArunPrakashG/media-offload#readme",
      },
      { label: "Email us", href: "mailto:hello@usenimbus.dev" },
      { label: "WordPress.org", href: "https://wordpress.org/plugins/" },
    ],
  },
  {
    heading: "Legal",
    items: [
      { label: "Privacy policy", href: "/privacy" },
      { label: "Terms of use", href: "/terms" },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <!-- Brand column -->
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Nimbus">
        <svg
          width="26"
          height="26"
          viewBox="0 0 32 32"
          fill="none"
          aria-hidden="true"
        >
          <rect width="32" height="32" rx="8" fill="#4f63f5"></rect>
          <path
            d="M7 20.5c0-2.8 2-5 4.8-5.4A6.5 6.5 0 0 1 22.5 14a4.5 4.5 0 0 1 2.5 8.2"
            stroke="#fff"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M13 22.5l3-3.8 3 3.8"
            stroke="#fff"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <line
            x1="16"
            y1="18.7"
            x2="16"
            y2="26"
            stroke="#fff"
            stroke-width="1.75"
            stroke-linecap="round"></line>
        </svg>
        <span>Nimbus</span>
      </a>

      <p class="footer-tagline">
        Cloud media offloading for WordPress.<br />
        S3, Cloudflare R2, and beyond.
      </p>

      <a class="footer-email" href="mailto:hello@usenimbus.dev">
        hello@usenimbus.dev
      </a>
    </div>

    <!-- Link columns -->
    {
      links.map((col) => (
        <div class="footer-col">
          <h4 class="footer-col-heading">{col.heading}</h4>
          <ul class="footer-col-links">
            {col.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="footer-link"
                  {...(item.href.startsWith("http")
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span class="footer-copy">© {year} Nimbus. All rights reserved.</span>
      <span class="footer-built">
        Built with
        <svg
          width="12"
          height="12"
          viewBox="0 0 16 16"
          fill="none"
          aria-label="love"
        >
          <path
            d="M8 13.5S2 9.8 2 5.8A3.5 3.5 0 0 1 8 3.4a3.5 3.5 0 0 1 6 2.4c0 4-6 7.7-6 7.7z"
            fill="var(--nmb-accent)"></path>
        </svg>
        for WordPress developers.
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--nmb-border-light);
    background: var(--nmb-surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  /* ── Brand ──────────────────────────────────────────────────────────────── */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--nmb-text);
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-bottom: 0.875rem;
  }

  .footer-logo:hover {
    color: var(--nmb-accent);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--nmb-text-muted);
    line-height: 1.65;
    margin-bottom: 0.875rem;
  }

  .footer-email {
    font-size: 0.875rem;
    color: var(--nmb-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .footer-email:hover {
    text-decoration: underline;
  }

  /* ── Link columns ───────────────────────────────────────────────────────── */
  .footer-col-heading {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--nmb-text);
    margin-bottom: 1rem;
  }

  .footer-col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--nmb-text-muted);
    text-decoration: none;
    transition: color var(--nmb-t);
  }

  .footer-link:hover {
    color: var(--nmb-text);
  }

  /* ── Bottom bar ─────────────────────────────────────────────────────────── */
  .footer-bottom {
    border-top: 1px solid var(--nmb-border-light);
    padding: 1.125rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-copy,
  .footer-built {
    font-size: 0.8125rem;
    color: var(--nmb-text-subtle);
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: auto 1fr 1fr;
      align-items: start;
      gap: 0 2rem;
    }

    .footer-logo {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }

    .footer-brand {
      grid-template-columns: 1fr;
    }

    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
