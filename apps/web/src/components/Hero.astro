---
const providers = [
  "Amazon S3",
  "Cloudflare R2",
  "Backblaze B2",
  "MinIO",
  "Wasabi",
  "DigitalOcean Spaces",
];
---

<section class="hero">
  <!-- Faint background glow -->
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-inner">
    <!-- Text block -->
    <div class="hero-content">
      <a class="badge badge-accent hero-badge" href="#features">
        <svg
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="currentColor"
          aria-hidden="true"
        >
          <circle cx="6" cy="6" r="3"></circle>
        </svg>
        Media offloading for WordPress
        <svg
          width="12"
          height="12"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 8h8M9 5l3 3-3 3"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <h1 class="hero-headline">
        Move your media<br />to the cloud.<br />
        <span class="hero-headline-accent">Keep your workflow.</span>
      </h1>

      <p class="hero-sub">
        Nimbus offloads your WordPress media library to Amazon S3, Cloudflare
        R2, or any S3-compatible storage — automatically, without changing how
        you upload or manage files.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="mailto:hello@usenimbus.dev">
          Get Nimbus
          <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          class="btn btn-ghost btn-lg"
          href="https://github.com/ArunPrakashG/media-offload"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          View on GitHub
        </a>
      </div>
    </div>

    <!-- Dashboard mockup -->
    <div class="hero-visual" aria-hidden="true">
      <div class="mockup">
        <!-- macOS-style title bar -->
        <div class="mockup-bar">
          <span class="mockup-dot dot-red"></span>
          <span class="mockup-dot dot-amber"></span>
          <span class="mockup-dot dot-green"></span>
          <span class="mockup-title">Nimbus · Storage</span>
        </div>

        <div class="mockup-body">
          <!-- Status row -->
          <div class="mockup-status">
            <span class="status-indicator"></span>
            <div>
              <div class="status-label">Connected to Cloudflare R2</div>
              <div class="status-sub">nimbus-media-prod · us-east-1</div>
            </div>
          </div>

          <!-- Stats -->
          <div class="mockup-stats">
            <div class="stat-tile">
              <span class="stat-value">1,247</span>
              <span class="stat-label">Files offloaded</span>
            </div>
            <div class="stat-tile">
              <span class="stat-value">4.2 GB</span>
              <span class="stat-label">Server space freed</span>
            </div>
            <div class="stat-tile">
              <span class="stat-value">17.8 GB</span>
              <span class="stat-label">Served via CDN</span>
            </div>
          </div>

          <div class="mockup-sep"></div>

          <!-- Recent uploads -->
          <div class="mockup-files-label">Recent uploads</div>
          <div class="mockup-files">
            {
              [
                ["banner-hero.jpg", "2s ago"],
                ["about-team.webp", "4s ago"],
                ["product-shot.png", "12s ago"],
              ].map(([name, time]) => (
                <div class="file-row">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 16 16"
                    fill="none"
                    class="file-icon"
                  >
                    <rect
                      x="2"
                      y="1"
                      width="10"
                      height="13"
                      rx="1.5"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />
                    <path
                      d="M5 6h6M5 9h4"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span class="file-name">{name}</span>
                  <span class="file-badge">offloaded</span>
                  <span class="file-time">{time}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Decorative blur sphere behind card -->
      <div class="visual-blur" aria-hidden="true"></div>
    </div>
  </div>

  <!-- Provider compatibility strip -->
  <div class="providers-strip">
    <div class="container providers-inner">
      <span class="providers-label">Compatible with</span>
      <span class="providers-list">
        {
          providers.map((p, i) => (
            <>
              <span class="provider">{p}</span>
              {i < providers.length - 1 && (
                <span class="providers-dot" aria-hidden="true">
                  ·
                </span>
              )}
            </>
          ))
        }
      </span>
    </div>
  </div>
</section>

<style>
  /* ── Layout ─────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 5rem;
  }

  .hero-glow {
    position: absolute;
    top: -180px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 500px;
    background: radial-gradient(
      ellipse at top,
      rgba(79, 99, 245, 0.07) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-bottom: 4rem;
  }

  /* ── Text ───────────────────────────────────────────────────────────────── */
  .hero-content {
    max-width: 560px;
  }

  .hero-badge {
    display: inline-flex;
    margin-bottom: 1.75rem;
    text-decoration: none;
    transition:
      background var(--nmb-t),
      box-shadow var(--nmb-t);
  }

  .hero-badge:hover {
    background: var(--nmb-accent-mid);
    box-shadow: 0 0 0 3px rgba(79, 99, 245, 0.1);
  }

  .hero-headline {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--nmb-text);
    margin-bottom: 1.25rem;
  }

  .hero-headline-accent {
    color: var(--nmb-accent);
  }

  .hero-sub {
    font-size: 1.0625rem;
    color: var(--nmb-text-muted);
    line-height: 1.7;
    max-width: 48ch;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  /* ── Mockup visual ──────────────────────────────────────────────────────── */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .visual-blur {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 380px;
    height: 380px;
    background: radial-gradient(
      ellipse,
      rgba(79, 99, 245, 0.1) 0%,
      transparent 70%
    );
    filter: blur(30px);
    pointer-events: none;
    z-index: 0;
  }

  .mockup {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    border-radius: var(--nmb-radius-lg);
    border: 1px solid var(--nmb-border);
    background: var(--nmb-surface);
    box-shadow:
      var(--nmb-shadow-lg),
      0 0 0 1px rgba(255, 255, 255, 0.6) inset;
    overflow: hidden;
  }

  /* ── Mockup bar ─────────────────────────────────────────────────────────── */
  .mockup-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
    background: var(--nmb-surface-muted);
    border-bottom: 1px solid var(--nmb-border-light);
    user-select: none;
  }

  .mockup-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-red {
    background: #ff5f57;
  }
  .dot-amber {
    background: #febc2e;
  }
  .dot-green {
    background: #28c840;
  }

  .mockup-title {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--nmb-text-subtle);
    margin-left: auto;
    margin-right: auto;
    font-family: var(--nmb-font-mono);
  }

  /* ── Mockup body ────────────────────────────────────────────────────────── */
  .mockup-body {
    padding: 1.125rem 1.25rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Status row */
  .mockup-status {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    background: var(--nmb-green-light);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: var(--nmb-radius-md);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--nmb-green);
    flex-shrink: 0;
    margin-top: 4px;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.24);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.24);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.08);
    }
  }

  .status-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #166534;
    line-height: 1.3;
  }

  .status-sub {
    font-size: 0.6875rem;
    color: #16a34a;
    font-family: var(--nmb-font-mono);
    margin-top: 1px;
  }

  /* Stats grid */
  .mockup-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .stat-tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0.625rem 0.75rem;
    background: var(--nmb-surface-alt);
    border: 1px solid var(--nmb-border-light);
    border-radius: var(--nmb-radius-sm);
  }

  .stat-value {
    font-size: 1rem;
    font-weight: 700;
    color: var(--nmb-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.6875rem;
    color: var(--nmb-text-subtle);
    line-height: 1.3;
  }

  /* Separator */
  .mockup-sep {
    height: 1px;
    background: var(--nmb-border-light);
    margin: 0 -0.125rem;
  }

  /* File list */
  .mockup-files-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--nmb-text-subtle);
  }

  .mockup-files {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .file-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.625rem;
    background: var(--nmb-surface-muted);
    border: 1px solid var(--nmb-border-light);
    border-radius: var(--nmb-radius-sm);
    transition: background var(--nmb-t);
  }

  .file-row:hover {
    background: var(--nmb-surface-alt);
  }

  .file-icon {
    color: var(--nmb-text-subtle);
    flex-shrink: 0;
  }

  .file-name {
    font-size: 0.75rem;
    font-family: var(--nmb-font-mono);
    color: var(--nmb-text-2);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-badge {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #166534;
    background: var(--nmb-green-light);
    padding: 1px 6px;
    border-radius: var(--nmb-radius-full);
    border: 1px solid rgba(34, 197, 94, 0.2);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .file-time {
    font-size: 0.6875rem;
    color: var(--nmb-text-subtle);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Providers strip ─────────────────────────────────────────────────────── */
  .providers-strip {
    border-top: 1px solid var(--nmb-border-light);
    padding: 1.125rem 0;
    background: var(--nmb-surface-muted);
  }

  .providers-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
  }

  .providers-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--nmb-text-subtle);
    white-space: nowrap;
  }

  .providers-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
  }

  .provider {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--nmb-text-muted);
    transition: color var(--nmb-t);
  }

  .providers-dot {
    color: var(--nmb-border);
    font-size: 0.875rem;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: left;
    }

    .hero-content {
      max-width: none;
    }
    .hero-sub {
      max-width: 56ch;
    }

    .hero-visual {
      max-width: 480px;
      margin: 0 auto;
      width: 100%;
    }
  }

  @media (max-width: 639px) {
    .hero {
      padding-top: 3rem;
    }

    .mockup-stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .stat-value {
      font-size: 0.875rem;
    }
  }
</style>
