---
const features = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15.5C3 13 4.8 11 7.2 10.6A6.5 6.5 0 0 1 18 9a4 4 0 0 1 3 7"/><path d="M10 20l2.5-3 2.5 3"/><line x1="12.5" y1="17" x2="12.5" y2="22"/></svg>`,
    title: "Any S3-compatible provider",
    desc: "Amazon S3, Cloudflare R2 (dedicated profile — just enter your Account ID), Backblaze B2, MinIO, Wasabi, and more. If it speaks S3, Nimbus works with it.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: "No provider lock-in — ever",
    desc: "Nimbus stores only a neutral bucket path per file, never a provider URL. CDN URLs are assembled at render time from your current settings — so switching providers, changing your CDN domain, or toggling local vs remote serving is always a single settings change, no database migration.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
    title: "Zero workflow disruption",
    desc: "Upload exactly as you always have. Every new file is offloaded asynchronously — zero response-time impact, no theme or plugin changes needed.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
    title: "Custom CDN delivery",
    desc: "Point every media URL to any domain — your CDN edge, a custom subdomain, or your bucket's public endpoint. Toggle between local and remote serving without touching a single post.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`,
    title: "Pauseable bulk migration",
    desc: "Move your entire existing media library to the cloud with a persistent job engine — pause mid-migration, see real-time progress, auto-retry failures, and resume from exactly where you stopped.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`,
    title: "Nightly off-hours processing",
    desc: "Schedule heavy offload work for low-traffic hours (default 3 AM). Up to 8 parallel workers process the queue automatically overnight, keeping peak-hour server resources free.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>`,
    title: "Automatic cache purging",
    desc: "Cloudflare, LiteSpeed Cache, WP Fastest Cache, and configurable Nginx PURGE — all triggered automatically after every offload, rewrite, or bulk migration. No stale CDN responses.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
    title: "Storage cost analytics",
    desc: "MIME-type breakdown, 6-month trend charts, top upload directories, and a live side-by-side S3 vs R2 cost comparison based on your actual library size.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
    title: "Page-builder integration rewriting",
    desc: "One-click URL migration for Elementor, Slider Revolution, Smart Slider 3, and NextGEN Gallery — database-level rewriting of legacy embedded URLs, included on paid plans.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`,
    title: "WP-CLI + REST API",
    desc: "Full wp nimbus command namespace for deploy, rewrite, revert, and sync. Plus a complete REST API with read and job-control endpoints for headless or CI/CD workflows.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v3l2 1"/></svg>`,
    title: "Live diagnostics & log viewer",
    desc: "Test your bucket connection with real write verification and specific error hints. Structured log viewer with up to 2,000 entries, filterable by level, source, or keyword.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6m-3-3v6M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>`,
    title: "Selective offload rules",
    desc: "Skip files below a minimum size, restrict to specific MIME types, or set path-pattern allow/deny rules using glob syntax — offload exactly what you want, nothing more.",
  },
];
---

<section class="section features" id="features">
  <div class="container">
    <div class="features-header">
      <p class="section-label">Features</p>
      <h2 class="section-headline">
        Everything you need.<br />Nothing you don't.
      </h2>
      <p class="section-sub">
        Nimbus gives you a complete cloud media pipeline — no provider lock-in,
        pauseable bulk jobs, automatic cache purging, and deep analytics.
        Everything built-in, nothing bolted on.
      </p>
    </div>

    <div class="features-grid">
      {
        features.map((f) => (
          <div class="feature-card">
            <div class="feature-icon" aria-hidden="true" set:html={f.icon} />
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ── Section header ──────────────────────────────────────────────────────── */
  .features-header {
    max-width: 560px;
    margin-bottom: 3.5rem;
  }

  .features-header .section-label {
    margin-bottom: 0.625rem;
  }
  .features-header .section-headline {
    margin-bottom: 1rem;
  }

  /* ── Grid ───────────────────────────────────────────────────────────────── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25px;
    background: var(--nmb-border);
    border: 1px solid var(--nmb-border);
    border-radius: var(--nmb-radius-lg);
    overflow: hidden;
  }

  /* ── Card ───────────────────────────────────────────────────────────────── */
  .feature-card {
    background: var(--nmb-surface);
    padding: 2rem 1.875rem;
    transition: background var(--nmb-t);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-card:hover {
    background: var(--nmb-surface-alt);
  }

  /* ── Icon ───────────────────────────────────────────────────────────────── */
  .feature-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--nmb-radius-sm);
    background: var(--nmb-accent-dim);
    border: 1px solid rgba(79, 99, 245, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--nmb-accent);
    flex-shrink: 0;
    transition:
      background var(--nmb-t),
      border-color var(--nmb-t);
  }

  .feature-card:hover .feature-icon {
    background: var(--nmb-accent-light);
    border-color: rgba(79, 99, 245, 0.2);
  }

  /* ── Text ───────────────────────────────────────────────────────────────── */
  .feature-title {
    font-size: 1rem;
    font-weight: 650;
    color: var(--nmb-text);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .feature-desc {
    font-size: 0.9375rem;
    color: var(--nmb-text-muted);
    line-height: 1.65;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 639px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .feature-card {
      padding: 1.75rem 1.5rem;
    }
  }
</style>
