---
const features = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15.5C3 13 4.8 11 7.2 10.6A6.5 6.5 0 0 1 18 9a4 4 0 0 1 3 7"/><path d="M10 20l2.5-3 2.5 3"/><line x1="12.5" y1="17" x2="12.5" y2="22"/></svg>`,
    title: "9 storage providers, all first-class",
    desc: "Amazon S3, Cloudflare R2, Google Cloud, DigitalOcean Spaces, Backblaze B2, Wasabi, MinIO — each with a dedicated profile that pre-fills the right endpoint, region, and settings. No guesswork.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: "Never locked in to one provider",
    desc: "Your database stores a relative path, not a provider URL. Switch from S3 to Cloudflare R2, change your CDN domain, or move to Backblaze B2 — one settings change, no find-replace queries, no downtime.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
    title: "Upload as you always have",
    desc: "Every image editors drag into the media library or upload through any plugin is automatically offloaded in the background. No workflow changes, no new steps, no plugin or theme changes required.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
    title: "Serve media from your own CDN domain",
    desc: "Point every media URL at any domain — a Cloudflare zone, a CloudFront distribution, or your own edge subdomain. Toggle between cloud and local serving instantly without touching a single post.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`,
    title: "Move your whole library without breaking a sweat",
    desc: "A persistent background job migrates thousands of existing files to the cloud. Pause when traffic spikes, resume from exactly where it stopped, and watch live progress — failures are automatically retried.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`,
    title: "Heavy lifting while your site is quiet",
    desc: "Schedule media processing for off-peak hours — default 3 AM. Nightly jobs run up to 8 parallel workers so server resources stay free for real visitors during the day.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>`,
    title: "Visitors always see the fresh version",
    desc: "After every offload, Nimbus automatically purges stale URLs from Cloudflare, LiteSpeed Cache, WP Fastest Cache, or your Nginx proxy. No stale 404s, no manual cache flushes.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
    title: "Know exactly what storage is costing you",
    desc: "MIME-type breakdown, 6-month upload trend charts, top upload directories, and a live side-by-side cost comparison between S3 and Cloudflare R2 based on your actual library size.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
    title: "Page builders just work",
    desc: "Elementor, Slider Revolution, Smart Slider 3, and NextGEN Gallery all store media URLs in their own database tables. Nimbus rewrites them in one click — no manual SQL, no broken layouts.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
    title: "Sell digital files without burning your bandwidth",
    desc: "WooCommerce downloads go straight from cloud storage to your customers via short-lived signed URLs. Your server is never involved — no bandwidth cost, no rate limiting, no timeouts.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`,
    title: "AI-ready: control Nimbus from any tool, agent, or pipeline",
    desc: "AI coding agents, CI pipelines, and automation scripts can drive Nimbus through its full WP-CLI command suite or REST API — trigger bulk migrations, query job status, rewrite URLs, and more without touching the WordPress admin. Works with GitHub Actions, n8n, Claude, Cursor, and any tool that can run a shell command or call an HTTP endpoint.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v3l2 1"/></svg>`,
    title: "Know exactly what went wrong and why",
    desc: "Test your bucket connection with a real write check — Nimbus tells you exactly which step failed. Structured logs capture every offload, restore, and cache purge, filterable by level or keyword.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6m-3-3v6M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>`,
    title: "Offload what matters, skip what doesn't",
    desc: "Set minimum file size thresholds, filter by MIME type, or use path glob patterns to allow or block specific upload folders. Perfect for skipping tiny thumbnails or keeping private files local.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    title: "One dashboard for your entire Multisite network",
    desc: "Super-admins get a network-level overview showing license status and offload statistics for every site — no more switching between dashboards to see what's happening.",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2H3v16h5v4l4-4h5l4-4V2z"/><line x1="9" y1="9" x2="9" y2="9"/><line x1="12" y1="9" x2="12" y2="9"/><line x1="15" y1="9" x2="15" y2="9"/></svg>`,
    title: "Clone staging to production in seconds",
    desc: "Export your entire configuration — storage credentials, offload rules, cache settings — as a JSON file. Import it on the production site and it's ready to go. Perfect for agency workflows.",
  },
];
---

<section class="section features" id="features">
  <div class="container">
    <div class="features-header">
      <p class="section-label">Features</p>
      <h2 class="section-headline">
        Built for sites that<br />can't afford to be slow.
      </h2>
      <p class="section-sub">
        Stop using your web server as a CDN. Nimbus moves your media to fast,
        cheap cloud storage — automatically, reversibly, without a single line
        of code. Every feature is built in. Nothing requires a paid add-on.
      </p>
    </div>

    <div class="features-grid">
      {
        features.map((f) => (
          <div class="feature-card">
            <div class="feature-icon" aria-hidden="true" set:html={f.icon} />
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ── Section header ──────────────────────────────────────────────────────── */
  .features-header {
    max-width: 560px;
    margin-bottom: 3.5rem;
  }

  .features-header .section-label {
    margin-bottom: 0.625rem;
  }
  .features-header .section-headline {
    margin-bottom: 1rem;
  }

  /* ── Grid ───────────────────────────────────────────────────────────────── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25px;
    background: var(--nmb-border);
    border: 1px solid var(--nmb-border);
    border-radius: var(--nmb-radius-lg);
    overflow: hidden;
  }

  /* ── Card ───────────────────────────────────────────────────────────────── */
  .feature-card {
    background: var(--nmb-surface);
    padding: 2rem 1.875rem;
    transition: background var(--nmb-t);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-card:hover {
    background: var(--nmb-surface-alt);
  }

  /* ── Icon ───────────────────────────────────────────────────────────────── */
  .feature-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--nmb-radius-sm);
    background: var(--nmb-accent-dim);
    border: 1px solid rgba(79, 99, 245, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--nmb-accent);
    flex-shrink: 0;
    transition:
      background var(--nmb-t),
      border-color var(--nmb-t);
  }

  .feature-card:hover .feature-icon {
    background: var(--nmb-accent-light);
    border-color: rgba(79, 99, 245, 0.2);
  }

  /* ── Text ───────────────────────────────────────────────────────────────── */
  .feature-title {
    font-size: 1rem;
    font-weight: 650;
    color: var(--nmb-text);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .feature-desc {
    font-size: 0.9375rem;
    color: var(--nmb-text-muted);
    line-height: 1.65;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 639px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .feature-card {
      padding: 1.75rem 1.5rem;
    }
  }
</style>
