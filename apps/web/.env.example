# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com/ → Settings → API Keys
# Use test-mode keys (rzp_test_*) for development.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Razorpay Subscription Plan IDs ────────────────────────────────────────────
# Create annual plans in Razorpay Dashboard → Subscriptions → Plans.
# All Nimbus plans are billed annually — no monthly plans.
RAZORPAY_PLAN_PERSONAL_ANNUAL=plan_
RAZORPAY_PLAN_PRO_ANNUAL=plan_
RAZORPAY_PLAN_AGENCY_ANNUAL=plan_

# ── Go Backend ───────────────────────────────────────────────────────────────
# URL of the Go license backend (no trailing slash).
# In production this is the internal URL visible to the Node SSR server.
BACKEND_URL=http://localhost:8090

# Shared secret that authenticates requests to the /admin/* routes on the backend.
# Must match ADMIN_API_SECRET set on the Go backend.
ADMIN_API_SECRET=replace_with_a_strong_random_value_generated_by_openssl

# ── Host (required for the Node SSR server in production) ─────────────────────
HOST=0.0.0.0
PORT=4321

