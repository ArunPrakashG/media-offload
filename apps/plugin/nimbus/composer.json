{
  "authors": [
    {
      "email": "contact@arunprakashg.com",
      "name": "Arun Prakash"
    }
  ],
  "autoload": {
    "psr-4": {
      "Nimbus\\Plugin\\": "src/"
    }
  },
  "description": "Plume offloads WordPress media to Amazon S3, Cloudflare R2, and S3-compatible storage with automatic URL rewriting.",
  "license": "MIT",
  "minimum-stability": "stable",
  "name": "arun-prakash/nimbus",
  "require": {
    "php": ">=8.1",
    "aws/aws-sdk-php": "^3.200"
  },
  "support": {
    "email": "contact@arunprakashg.com"
  },
  "type": "wordpress-plugin",
  "config": {
    "autoloader-suffix": "NimbusMediaOffload",
    "platform": {
      "php": "8.1.0"
    }
  },
  "scripts": {
    "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices"
  },
  "extra": {
    "aws/aws-sdk-php": [
      "S3"
    ]
  }
}